  command: "dealer"
  salary: 1
  max: 2
  hasLicense: false
  category: "Citizens of Liver Failure"
  speech_sounds: ["placenta/speech/dealer#{i}.wav" for i=1,3]
  first_names: { "Kanan", "Merce", "Ameel", "Otis", "Cedric", "Edwin", "Floy", "Benjamin", "Fortune", "William", "Thomas", "Dean", "Aurum", "Klep" }
  last_names: { "Chapman", "Merchant", "Cash", "Keeper", "Bones", "Ryker", "Plutarch", "Nasir", "Greenback", "Grocer", "Flanders", "Hooper", "Watto", "Loman", "Stehlen", "Reichmann", "Kaufmann" } 
  special_name: "Unfortunate Shopkeep"
  special_name_chance: 1000
