-- For examples and explanation please visit this wiki page:
-- https://darkrp.miraheze.org/wiki/DarkRP:CustomJobFields

import Config from GAMEMODE

-- `global ^' makes all variable defs that begin with uppercase
-- characters globals by default.
global ^

set_bodygroup = (ply, slot, val) ->
  if type(val) == "table"
    -- it *should* be a sequential table
    val = val[math.random(1, #val)]
  ply\SetBodygroup slot, val

open_player_menu = (ply) ->
  return unless CLIENT
  if lp\Alive!
    GAMEMODE\CreatePlayerMenu!
  else
    GAMEMODE\Frighten!

open_action_menu = (ply) ->
  return unless CLIENT
  tr = GAMEMODE\GetHandTrace(ply, 80)
  GAMEMODE\OpenActionMenu(tr.HitPos, tr.Entity)

TEAM_GHOST = DarkRP.createJob "Ghost",
  color: Color(150, 150, 150)
  model: "models/player/skeleton.mdl"
  description: "A lost soul."
  instant_respawn: true
  weapons: {}
  command: "ghost"
  salary: 1
  max: 0
  speech_sounds: {"ambient/voices/squeal1.wav"}
  crosstext: (ply) ->
    -- presumably, these only apply to cotards
    text = "OH SOTLA,\nTHE HORROR."
    switch lp\Team!
      when TEAM_KORPSMAN
        text = "Evil spirits wander!\n<wiggle>Not on my shift."
      when TEAM_GHOST
        text = "We're the same,\nyou and I."
    return { :text, font: "Spleen_Label_Small" }
  first_names: {"Suffering", "Fear", "Agony", "Malice", "Hatred", "Grief", "Pain", "Despair", "Rage" }
  -- special_name: "gost"
  -- special_name_chance: 10000
  ShowSpare1: (ply) ->
    if CLIENT
      GAMEMODE\Frighten!
  ShowSpare2: (ply) ->
    nearby = ents.FindInSphere(ply\GetPos!, 16)
    local found
    for ent in *nearby
      if ent\GetClass!\find"portal/spawn"
        found = ent
        break
    unless found and IsValid(found)
      if CLIENT
        GAMEMODE\Frighten!
      else
        ply\Notify"<c=200,0,0>There is no purpose in life near me."
    elseif SERVER
      found\Use(ply)
  PlayerLoadout: (ply) ->
    -- We don't want ghosts to get default weapons.
    ply\ClearOddities!
    ply\SetNWInt "evilrp_gasmask", 0
    return true
  ColorMod: (ply) ->
    import abs, cos, sin from math
    ct = CurTime!
    tab =
        ["$pp_colour_addr"]: 0
        ["$pp_colour_addg"]: 0
        ["$pp_colour_addb"]: 0
        ["$pp_colour_brightness"]: 0 + (-0.01 * cos(ct))
        ["$pp_colour_contrast"]: 0.6 + (abs(sin(ct * 0.166)) * 0.5)
        ["$pp_colour_colour"]: 0
        ["$pp_colour_mulr"]: 0 + abs(sin(ct * 0.789))
        ["$pp_colour_mulg"]: 0
        ["$pp_colour_mulb"]: 0
    return tab

class SpeechBonehead extends SOUND
  sound: "placenta/bonehead_aggrod4.wav"
  pitch: {200, 250}

TEAM_BONEHEAD = DarkRP.createJob "Bonehead",
  color: Color(150, 150, 150)
  model: "models/splinks/thug2/skaters/phil.mdl"
  description: "my big dirty azz."
  instant_respawn: true
  command: "bonehead"
  salary: 1
  max: 0
  speech_sounds: "SpeechBonehead"
  hurt_sounds: ["placenta/bonehead_slice#{i}.wav" for i=1,2]
  become_sounds: ["placenta/bonehead_aggrod#{i}.wav" for i=1,4]
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "Oh no! He's real!"
      when TEAM_SANITAR
        text = "Oh boy."
      when TEAM_KORPSMAN
        text = "Oh no! It happened again!"
      when TEAM_KOMMANDANT
        text = "Ha. It happened again."
      when TEAM_GHOST
        text = "Lookin' good."
      when TEAM_BONEHEAD
        text = "THERE'S ANOTHER ONE."
    return { :text, font: "Spleen_Label_Small" }, false
  first_names: { "Phil" }
  last_names: { "Margera"}
  no_needs: true
  hint: "You are a truly pissed off skeleton. Go get 'em!"
  bar_names:
    health: "MARGERA POWER"
  bar_colors:
    health: Color(200,0,0)
  RenderScreenspaceEffects: (ply) ->
    ct = CurTime!
    DrawMotionBlur 0.25, 0.2, 0.3
    DrawSharpen 1 * math.sin(ct), 2 * math.random(0.8, 1.2)
  ColorMod: (ply) ->
    import abs, cos, sin from math
    ct = CurTime!
    tab =
      ["$pp_colour_addr"]: 0.1
      ["$pp_colour_addg"]: 0
      ["$pp_colour_addb"]: 0
      ["$pp_colour_brightness"]: 0 + (-0.01 * cos(ct))
      ["$pp_colour_contrast"]: 1.6 + (abs(sin(ct * 0.166)) * 0.5)
      ["$pp_colour_colour"]: 0
      ["$pp_colour_mulr"]: 0 + abs(sin(ct * 0.789))
      ["$pp_colour_mulg"]: 0
      ["$pp_colour_mulb"]: 0
    return tab
  ShowSpare1: ->
    if CLIENT
      GAMEMODE\Frighten!
  ShowSpare2: ->
    if CLIENT
      GAMEMODE\Frighten!
  PlayerLoadout: (ply) ->
    ply\SetNWInt "evilrp_gasmask", 0
    ply\Give("evilrp_melee/hands/boneclaws")
    return true
  HandleRagdoll: (rag, ply) ->
    rag\SetNWInt("decomp_stage", DSTAGE_BONES)
    
TEAM_PRIVATE = DarkRP.createJob "Private",
  color: Color(20, 150, 20)
  model: "models/vel/evilwar/royalist.mdl"
  description: "A new recruit that hasn't gone through training yet."
  weapons: {"evilrp_weapon/mark", "evilrp_melee/pipe"}
  command: "proletariat"
  salary: 1
  max: 0
  hasLicense: true
  candemote: false
  category: "Citizens of Liver Failure"
  speech_sounds: ["placenta/speech/prole#{i}.wav" for i=1,3]
  hurt_sounds: ["placenta/pain/prole#{i}.wav" for i=1,5]
  become_sounds: ["npc/zombie/zombie_alert#{i}.wav" for i=1,3]
  death_sounds: ["placenta/death/prole#{i}.wav" for i=1,3]
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "United in rank?"
      when TEAM_SANITAR
        text = "Keep the fear\nin his heart."
      when TEAM_KORPSMAN
        text = "Smelly."
      when TEAM_KOMMANDANT
        text = "Is he working hard enough?"
      when TEAM_GHOST
        text = "Sad, but funny."
      when TEAM_BONEHEAD
        text = "SKIN...!"
    return { :text, font: "Spleen_Label_Small" }, false
  first_names: { "Private", "PVT.", "Recruit" }
 
  special_name: "Meatwad"
  special_name_chance: 1000
  ShowSpare1: open_player_menu
  ShowSpare2: open_action_menu
  PlayerLoadout: (ply) ->
    ply\ClearOddities!
    ply\AddOddity ODDITY.list[math.random(#ODDITY.list)]
    set_bodygroup(ply, slot, val) for slot, val in pairs {
      -- torse
      [0]: 0
      -- vest
      [1]: 0
      -- headwear
      [2]: 0
      -- face
      [3]: 0
      -- pants
      [4]: 1
      -- hands
      [5]: 0
    }
    return false

TEAM_SANITAR = DarkRP.createJob "Dragoon",
  color: Color(25, 170, 0)
  model: "models/vel/evilwar/royalist.mdl"
  description: "Liver Failure's white blood cells.\nNot necessarily protecting the red,\nbut preventing disease before they reach the vital organs."
  weapons: {"evilrp_weapon/pacifier", "simple_hl2_stunstick"}
  command: "ss"
  salary: 1
  max: 6
  hasLicense: true
  ammo:
    pistol: 60
  category: "Sanitar Squad"
  speech_sounds: ["placenta/speech/chatter#{i}.ogg" for i=1,15]
  hurt_sounds: ["placenta/pain/sanitar#{i}.wav" for i=1,4]
  become_sounds: ["ambient/levels/prison/radio_random#{i}.wav" for i=1, 15]
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "The Cell is here."
      when TEAM_SANITAR
        text = "One of my only\n friends here."
      when TEAM_KORPSMAN
        text = "Beware of shadows in the\nNight of the Long Pipes."
      when TEAM_KOMMANDANT
        text = "A tentacle of mine."
      when TEAM_GHOST
        text = "Evil, stupid,\n maybe both."
      when TEAM_BONEHEAD
        text = "DANGER."
    return { :text, font: "Spleen_Label_Small" }, true
  first_names: { "Subjugator", "Dragoner", "Persecuter", "Draconarius", "Volontaire"}
  last_names: { "of Die Augen", "of Knochen", "of Sehne", "of Knorpel", "of Bauchspeicheldrüse" }
  arms_model: "models/weapons/c_arms_refugee.mdl"
  ShowSpare1: open_player_menu
  ShowSpare2: open_action_menu
  bar_names:
    health: "resolve"
  PlayerLoadout: (ply) ->
    ply\ClearOddities!
    ply\AddOddity ODDITY.list[math.random(#ODDITY.list)]
    set_bodygroup(ply, slot, val) for slot, val in pairs {
      -- torse
      [0]: 1
      -- vest
      [1]: 1
      -- headwear
      [2]: 1
      -- face
      [3]: 2
      -- pants
      [4]: 3
      -- hands
      [5]: 0
    }
    return false

TEAM_DEALER = DarkRP.createJob "Dealer",
