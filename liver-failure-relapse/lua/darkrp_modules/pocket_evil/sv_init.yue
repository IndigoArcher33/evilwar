util.AddNetworkString"EvilRP_Pocket"
util.AddNetworkString"EvilRP_PocketMenu"
util.AddNetworkString"EvilRP_spawnPocket"

send_pocket_items = (ply) ->
  net.Start "EvilRP_Pocket"
  net.WriteTable ply\GetPocketItems!
  net.Send ply

hook.Add "OnPlayerChangedTeam", "evilrp_send_pocket", send_pocket_items
    
meta = FindMetaTable"Player"

-- these exist to replace the default player metatable pocket
-- functions in default darkRP module's pocket/sv_init.lua
meta[k] = v for k, v in pairs{
  GetPocketItems: =>
    @darkRPPocket = @darkRPPocket or {}
    res = {}
    for k, v in pairs @darkRPPocket
      r = {
        model: v.Model
        class: v.Class
      }
      r.wepcls = v.DT.WeaponClass if v.DT
      res[k] = r
    return res
}

net.Receive "EvilRP_spawnPocket", (len, ply) ->
  item = net.ReadFloat!
  use = net.ReadBool!
  return unless (ply.darkRPPocket and ply.darkRPPocket[item])
  return unless ply\Alive!
  can_pickup, message = hook.Call "canDropPocketItem", nil, ply, item, ply.darkRPPocket[item]
  if can_pickup == false
    DarkRP.notify ply, 1, 4, message if message
    send_pocket_items ply
    return
  dropped = ply\dropPocketItem item
  if use
    timer.Simple 0.1, ->
      dropped.inventory_use = true
      dropped\Use(ply)
      if dropped\GetNWBool("usefail")
        dropped\SetNWBool("usefail", false)
        ply\addPocketItem(dropped)
  else
    dropped\SetNWEntity "evilrp_submitter", ply

drop_pocket_item = (ply) ->
  return unless (IsValid(ply) and ply\Alive!)
  return if ply\Team! == TEAM_GHOST
  max_k = 0
  for k in pairs(ply\GetPocketItems!)
    continue if k < max_k
    max_k = k
  if max_k > 0
    item = ply\dropPocketItem(max_k)
    timer.Simple(0.0666, -> ply\PickupObject(item) if item and IsValid(item) and item\GetClass!\find"trash/*")

hook.Add "ShowHelp", "evilrp_drop_pocket_item", drop_pocket_item

