global gterm
gterm or= {}

global GT_COL_NIL  = 0
global GT_COL_MSG  = 1
global GT_COL_WRN  = 2
global GT_COL_ERR  = 3
global GT_COL_INFO = 4
global GT_COL_INTL = 5
global GT_COL_CMD  = 6
global GT_COL_SUCC = 7

gterm.ColorFromIndex = (code) =>
  col = switch code
    when GT_COL_MSG
      Color(255,255,255)
    when GT_COL_WRN
      Color(255,250, 50)
    when GT_COL_ERR
      Color(255,50,50)
    when GT_COL_INFO
      Color(250,0,150)
    when GT_COL_INTL
      Color(60,250,250)
    when GT_COL_CMD
      Color(175,175,175)
    when GT_COL_SUCC
      Color(75,255,80)
    else
      Color(50,50,50)
  return col
