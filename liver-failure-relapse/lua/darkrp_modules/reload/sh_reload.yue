next_reload_sound = 0
gmacs = false
reload_jumpscare = ->
  return if gmacs
  if CLIENT
    lp = LocalPlayer!
    if CurTime! > next_reload_sound
      lp\EmitSound "npc/combine_gunship/ping_patrol.wav", 75, math.random(80,90), 0.2
      util.ScreenShake lp\GetPos!, 25, 5, 3, 5000
      next_reload_sound = CurTime! + 5
  return
hook.Add "OnReloaded", "evilrp_reload_jumpscare", reload_jumpscare
