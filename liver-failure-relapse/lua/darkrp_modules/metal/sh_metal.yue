class Submit_Metal extends SOUND
  sound: ["weapons/crowbar/crowbar_impact#{i}.wav" for i=1,2]

class Metal extends ITEM
  @__entity: "metal"
  Spawnable: true

  Category: "EvilRP: Precursor"

  Sound: "npc/barnacle/neck_snap#{math.random(1, 2)}.wav"

  SubmitSound: "Submit_Metal"

  Submitted: =>
    pos = @GetPos!
    ed = EffectData!
    with ed
      \SetOrigin pos
      \SetScale 1
      \SetMagnitude 1
      \SetRadius 3
    util.Effect "Sparks", ed
    
  OnlyInventoryUse: false
    
  OnUseFinish: (ply) =>
    super ply
    dmg = DamageInfo!
    with dmg
      \SetDamage @BiteDamage
      \SetDamageType DMG_SLASH
      \SetAttacker ply
      \SetInflictor @
      \SetDamagePosition ply\EyePos!
    ply\TakeDamageInfo dmg
    @Remove!
      
class Scrap extends Metal
  Model: Model"models/gibs/manhack_gib01.mdl"

  PrintName: "Scrap Metal"
  Description: "A chunk of delectable scrap metal."
  UseText: {
    "%s cuts their tongue eating the sharp metal."
    "%s disfigures themselves enjoying a nice chunk of metal."
    "%s lets the sharp metal wreak havoc on their stomach."
    "%s pierces their cheeks trying to eat scrap metal."
  }

  BiteDamage: 25
    
  Precursor:
    metal: 1


class Slag extends Metal
  Model: Model"models/props_junk/rock001a.mdl"

  PrintName: "Slag Metal"
  Description: "A rock with a piece of metal stuck in it.\nCan be processed in a Refinery."
  UseText: {
    "%s breaks their teeth trying to crack open the slag metal."
    "%s shatters their morals gnawing a piece of slag metal."
    "%s hurts their jaw on a piece of slag metal."
  }

  BiteDamage: 34
    
  Refinement:
    result: "metal/scrap"
    time: 2
