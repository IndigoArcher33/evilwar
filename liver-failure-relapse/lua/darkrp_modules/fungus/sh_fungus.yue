-- this is all based on the original Blastfungus addon
-- https://steamcommunity.com/sharedfiles/filedetails/?id=112418323

fungus_max = 666

fungus_breed_delay = { min: 2, max: 8 }
fungus_breed_distance = { min: 25, max: 100 }

fungus_balloon_size_increase = { min: 5.0, max: 10.0 }

fungus_lightning_zap_delay = { min: 0.05, max: 0.15 }

fungus_lifespan = { min: 25, max: 35 }
fungus_think_rate = 0.15

global fungus_currentpop
fungus_currentpop or= 0

fungus_float_power = { min: -100, max: 100 }
fungus_evolve_mutation = { rate: 0.10, chance: 25.0 }

-- next_spawn_time = CurTime!

fungus_next_think = CurTime!
if SERVER
  global fungus_all
  fungus_all or= {}

if SERVER
  on_fungus_think = ->
    global fungus_all
    ct = CurTime!
    if ct >= fungus_next_think
      fungus_next_think = ct + fungus_think_rate
      -- clean out any nil values and re-create master table
      clean_list = {}
      for k, v in pairs fungus_all
        clean_list[] = v if v ~= nil and IsValid(v)
      fungus_all = clean_list
      fungus_currentpop = #fungus_all
      -- think for all fungi
      for k, v in pairs fungus_all
        v\OnFungusThink! if IsValid(v)
  hook.Add "Think", "evilrp_fungus", on_fungus_think

class FungusBreed extends SOUND
  sound: ["weapons/bugbait/bugbait_squeeze#{i}.wav" for i=1,3]
  level: SNDLVL_50DB
  volume: 0.2

class FungusPop extends SOUND
  sound: "phx/eggcrack.wav"
  level: SNDLVL_40DB
  pitch: {85, 115}

class LFR_FungalSpores extends FX
  Init: (data) =>
    local pos, speed, ang, scale
    with data
      pos = \GetOrigin!
      speed = \GetStart!
      ang = \GetNormal!
      scale = \GetScale!
    for i=1,3
      chance = math.Round math.Rand(1,3)
      particle_mat = "decals/bloodyflesh/blood#{math.random(1,4)}"
      if GAMEMODE.Emitter2D
        particle = GAMEMODE.Emitter2D\Add particle_mat, pos
        vel = ((ang * 2) * i) * 1
        vel = vel + Vector(math.random(-4,-14), math.random(-4,4), math.random(-4,4))
        with particle
          \SetVelocity vel
          \SetDieTime math.Rand(1,4)
          \SetEndAlpha 0
          \SetDieTime math.Rand(1,4)
          \SetEndAlpha 0
          \SetStartSize 1 * scale
          \SetEndSize math.random(2, 4) * scale
          \SetRoll math.Rand(-10, 10)
          \SetRollDelta math.Rand(-0.2, 0.2)
          color_num = math.Rand(20, 75)
          \SetColor color_num, color_num, color_num
          \SetStartAlpha color_num
          \SetGravity Vector(0, 0, math.random(60, 120))
          \SetCollide true
          \SetAirResistance 300
          \SetBounce 2        
  Render: =>
  Think: => false

class Fungus extends ENTITY
  Type: "anim"
  Base: "base_gmodentity"

  PrintName: "Fungus"

  Category: "EvilRP: Fungus"

  Spawnable: true
  AdminSpawnable: true

  -- not all fungus should necessarily go bang
  -- TODO: fungus/explosive

  model: Model"models/weapons/w_bugbait.mdl"
  radius: 100
  damage: 30
  exploded: false

  Initialize: =>
    if CLIENT
      @SetRenderMode RENDERMODE_TRANSALPHA
      @RenderGroup = RENDERGROUP_TRANSLUCENT
    elseif SERVER
      fungus_all[] = @
      ct = CurTime!
      with fungus_lifespan
        @death_time = (ct + math.Rand(.min, .max))
      with fungus_breed_delay
        @next_spawn_time = (ct + math.Rand(.min, .max))

      @SetModel @model
      @PhysicsInitSphere 3
      @SetMoveType MOVETYPE_VPHYSICS
      @SetSolid SOLID_VPHYSICS
      @SetRenderMode RENDERMODE_TRANSALPHA
      @RenderGroup = RENDERGROUP_TRANSLUCENT
      @SetColor( Color(0,0,0,230) )

      fungus_currentpop += 1

      util.PrecacheSound("weapons/bugbait/bugbait_squeeze#{i}.wav") for i=1,3

  OnTakeDamage: (dmg) =>
    attacker = dmg\GetAttacker!
    @FungusAction! unless attacker\GetClass!\find"fungus"

  Touch: (activator) =>
    @FungusAction(activator) if IsValid(activator) and not activator\GetClass!\find"fungus"

  OnFungusThink: =>
    ct = CurTime!
    if ct >= @death_time
      @FungusDeath!
    elseif ct >= @next_spawn_time
      @FungusBreed!
    return true

  OnRemove: => fungus_currentpop -= 1

  FungusAction: (activator) =>
    unless @exploded
      puff = ents.Create"env_smoketrail"
      kvs = {
        startsize: "10"
        endsize: "20"
        minspeed: "1"
        maxspeed: "2"
        startcolor: "40 40 40"
        endcolor: "0 40 0"
        opacity: ".8"
        spawnrate: "5"
        lifetime: "1"
      }
      with puff
        \SetKeyValue k, v for k, v in pairs(kvs)
        \SetPos @GetPos!
        \Spawn!
        \Fire "kill", "", 0.7
      pos = @GetPos!
      if activator and IsValid(activator) and activator\IsPlayer!
        activator\AddDespair math.random(2,4)
      -- explosion = EffectData!
      -- with explosion
      --   \SetOrigin pos
      --   \SetStart pos
      --   \SetMagnitude 80
      --   \SetScale 10
      --   \SetRadius 30
      -- util.Effect "Explosion", explosion
      -- util.BlastDamage @, @, pos, @radius, @damage
      @EmitSound"FungusPop"
      edata = EffectData!
      with edata
        \SetOrigin pos
        \SetScale 2
        \SetNormal @GetUp!
      util.Effect "LFR_FungalSpores", edata
    @exploded = true
    @Remove!

  FungusDeath: =>
    puff = ents.Create"env_smoketrail"
    kvs = {
      startsize: "10"
      endsize: "20"
      minspeed: "1"
      maxspeed: "2"
      startcolor: "40 40 40"
      endcolor: "0 40 0"
      opacity: ".8"
      spawnrate: "5"
      lifetime: "1"
    }
    with puff
      \SetKeyValue k, v for k, v in pairs(kvs)
      \SetPos @GetPos!
      \Spawn!
      \Fire "kill", "", 0.7
    @Remove!

  FungusBreed: =>
    breed_success = false
    ct = CurTime!
    return if fungus_currentpop >= fungus_max
    -- begin tracing a few feet away from the current fungus
    trace_pos = @GetPos! + (@GetForward! * 16)
    local x, y, z
    with fungus_breed_distance
      x = trace_pos.x + math.Rand(-.min, .max)
      y = trace_pos.y + math.Rand(-.min, .max)
      z = trace_pos.z + math.Rand(-.min, .max)
    trace = {
      start: trace_pos
      endpos: Vector(x, y, z)
    }
    tr = util.TraceLine trace
    -- if we hit something, and it isn't the sky...
    if tr.Hit and not tr.HitSky
      -- if we hit something that is not solid ground...
      if tr.HitNonWorld
        -- make sure it isn't the player, fungus, or an NPC
        hitentity = tr.Entity\GetClass!
        return if hitentity == "player"
        return if hitentity\find"fungus"
        return if hitentity\find"npc"
      -- if the trace hit close by...
      dist = @GetPos!\Distance(tr.HitPos)
      if dist >= fungus_breed_distance.min and dist <= fungus_breed_distance.max
        -- spawn!
        spawn_pos = tr.HitPos + tr.HitNormal * 2
        spawn_angle = tr.HitNormal\Angle!
        ent = ents.Create @GetClass!
        with ent
          \SetPos spawn_pos
          \SetAngles spawn_angle
          \Spawn!
          \Activate!
          \Initialize! -- not sure why this is called here
          \SetOwner tr.Entity
        -- make a noise
        ent\EmitSound"FungusBreed"
        -- weld to the thing we hit; disable motion if we stick to the map,
        -- otherwise stick to our victim
        if tr.Entity\IsWorld!
          ent\GetPhysicsObject!\EnableMotion(false)
        else
          weld = constraint.Weld(ent, tr.Entity, 0, tr.PhysicsBone, 0)
        -- we did it
        breed_success = true
    if breed_success
      import min, max from fungus_breed_delay
      @next_spawn_time = (ct + math.Rand(min, max))
