class Illiteracy extends ODDITY
  name: "Illiteracy"
  desc: "I have no ability to read or write. Whatever."
global ODDITY_ILLITERACY = Illiteracy.index

class Delinquency extends ODDITY
  name: "Delinquency"
  desc: "I love to cause trouble and break things."
global ODDITY_DELINQUENCY = Delinquency.index

class Clumsy extends ODDITY
  name: "Clumsy"
  desc: "I've got two left feet."
global ODDITY_CLUMSY = Clumsy.index

meta = FindMetaTable"Player"
meta[k] = v for k, v in pairs{
  Oddities: => @GetNWInt("evilrp_oddities", 0)
  OddityList: =>
    returns = {}
    for k, v in pairs(ODDITIES)
      returns[] = v if @HasOddity k
    return returns
  HasOddity: (oddity) => bit.Check(@Oddities!, oddity)
  ClearOddities: => @SetNWInt("evilrp_oddities", 0)
  AddOddity: (oddity) =>
    return if @HasOddity(oddity)
    odds = bit.Set(@Oddities!, oddity)
    @SetNWInt("evilrp_oddities", odds)
    timer.Simple( 1, -> ODDITIES[oddity]\Inform @ )
    return odds
  RemoveOddity: (oddity) =>
    return unless @HasOddity(oddity)
    odds = bit.Unset(@Oddities!, oddity)
    @SetNWInt("evilrp_oddities", odds)
    return odds
}
