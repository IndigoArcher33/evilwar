ODDITY.index = 0
ODDITY.list = {}

class Cotardism extends ODDITY
  name: "Cotardism"
  desc: "I see dead people, and I fear them."
  GetDesc: (ply) =>
    desc = super ply
    if ply\Team! == TEAM_KORPSMAN
      desc ..= "\n     <c=128,0,0>...but they will fear me <wiggle>more.</wiggle>"
    return desc
global ODDITY_COTARDISM = Cotardism.index

class Necrophilia extends ODDITY
  name: "Necrophilia"
  desc: "I love the dead. The more rotten, the better."
global ODDITY_NECROPHILIA = Necrophilia.index

class Cannibalism extends ODDITY
  name: "Cannibalism"
  desc: "Only other corpses can sate my hunger. My only drinking buddies are dead bodies."
global ODDITY_CANNIBALISM = Cannibalism.index

class Depression extends ODDITY
  name: "Depression"
  desc: "It's hard being a corpse. It's hard, and nobody understands."
global ODDITY_DEPRESSION = Depression.index

