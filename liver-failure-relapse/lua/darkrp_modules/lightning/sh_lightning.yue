smite_dmg_range = { 35, 100 }

GAMEMODE.LightningStrike = (origin, dest) =>
  if SERVER
    tr = util.TraceHull({
      start: origin
      endpos: dest
    })
    edata = EffectData!
    world = Entity 0
    with edata
      -- don't know why this is like this, but i didn't write it
      -- no offense ffv 💙
      start = util.QuickTrace(tr.HitPos,(tr.HitNormal+Vector(0,0,2))\GetNormalized()*9999,tr.Entity).HitPos
      \SetStart start
      \SetOrigin tr.HitPos
      util.Effect "ffvlightningbolt", edata, true, true
      if tr.HitNonWorld and tr.Hit
        victim = tr.Entity
        dmg = DamageInfo!
        with dmg
          \SetDamage math.random(smite_dmg_range[1], smite_dmg_range[2])
          \SetDamageType DMG_SHOCK
          \SetInflictor world
          \SetAttacker world
          victim\TakeDamageInfo dmg if IsValid(victim)
          timer.Simple( 1, ->
            return unless (victim and IsValid(victim) and victim\IsPlayer! and not victim\Alive!)
            rag = victim\Ragdoll!
            return unless (rag and IsValid(rag))
            rag\Fire"StartRagdollBoogie"
          )
      if tr.Hit    
        if (not tr.Entity\IsPlayer!) or (not tr.Entity\Alive!)
          util.BlastDamage(world, world, tr.HitPos, 200, 80)


GAMEMODE.LightningPunish = (ply) =>
  where = ply\EyePos!
  @LightningStrike(where, where)
          
if SERVER
  util.AddNetworkString"evilrp_smite"        
  net.Receive "evilrp_smite", (len, ply) ->
    return unless ply\IsAdmin!
    victim = net.ReadEntity!
    return unless (victim and IsValid(victim))
    where = victim\EyePos!
    GAMEMODE\LightningStrike(where, where)
 
smite = (ply, cmd, args) ->
  return if ply\EntIndex! ~= 0 and not ply\IsAdmin!
  if #args > 0 -- we're targeting someone
    victim = GAMEMODE\FindPlayer(args[1])
    unless (victim and IsValid(victim) and victim\IsPlayer! and victim\Alive!)
      MsgC Color(200,0,0), "No living victim was found by that name.\n"
      return
    if SERVER
      where = victim\EyePos!
      GAMEMODE\LightningStrike(where, where)
      MsgC Color(200,200,0), "#{victim\Nick!} was struck by lightning.\n"
    else
      net.Start"evilrp_smite"
      net.WriteEntity(victim)
      net.SendToServer!
  elseif (ply\EntIndex! ~= 0) -- smite whatever we're looking at
    tr = GAMEMODE\GetHandTrace(ply, 4096)
    victim = tr.Entity
    unless (victim and IsValid(victim))
      ply\Notify"<c=200,0,0>I'm not targeting something worth the punishment."
      return
    net.Start"evilrp_smite"
    net.WriteEntity(victim)
    net.SendToServer!
concommand.Add "smite", smite
