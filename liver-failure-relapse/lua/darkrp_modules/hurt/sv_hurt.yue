play_hurt_sound = (ent) ->
  ct = CurTime!
  if not ent.NextGrunt
    ent.NextGrunt = ct
  if ent\IsPlayer! and ent\IsValid! and ent\Alive!
    if (ct >= ent.NextGrunt and ent\Team() ~= TEAM_GHOST)
      ent.NextGrunt = ct + math.random(0.5, 2)
      if ent.dont_scream
        ent.dont_scream = false
      else
        jt = ent\getJobTable!
        if jt.hurt_sounds
          sounds = jt.hurt_sounds
          snd = sounds[math.random(1, #sounds)]
          ent\EmitSound snd, 80, math.random(95, 110)
  return

hook.Add "EntityTakeDamage", "evilrp_hurt_sound", play_hurt_sound

