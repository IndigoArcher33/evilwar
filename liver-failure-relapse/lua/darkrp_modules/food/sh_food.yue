class FoodRot extends SOUND
  sound: ["weapons/bugbait/bugbait_squeeze#{i}.wav" for i=1,3]
  level: SNDLVL_50dB

class Food extends ITEM
  SetupDataTables: =>
    super!
    @NetworkVar "Bool", "Rotten"

  Model: Model"models/props_junk/garbage_plasticbottle002a.mdl"
  Category: "EvilRP: Food"
  Spawnable: true
  Interesting: true

  Sound: Sound"npc/barnacle/barnacle_crunch2.wav"

  Hunger: 0 -- use negative numbers to satisfy a status
  Thirst: 0
  Despair: 0
  HealthAdd: 0 -- temp until we get a new health system

  RotTime: 0 -- 0 means never rot

  Eat: (ply) =>
    return if CLIENT
    local amt
    if @Hunger
      amt = @Hunger
      amt = amt! if isfunction(amt)
      ply\AddHunger amt
    if @Thirst
      amt = @Thirst
      amt = amt! if isfunction(amt)
      ply\AddThirst amt
    if @Despair
      amt = @Despair
      amt = amt! if isfunction(amt)
      ply\AddDespair amt
    if @HealthAdd
      amt = @HealthAdd
      amt = amt! if isfunction(amt)
      if amt > 0
        ply\SetHealth math.min( ply\Health! + amt, ply\GetMaxHealth! )
      elseif amt < 0
        ply\TakeDamage -amt
        -- if @GetRotten!
        --   ply\AddStatus STATUS_POISON, math.random(1,3)
    @Trash! if not @PersistAfterEat

  OnUseFinish: (ply) =>
    super ply
    @Eat ply

  OnSpawned: =>
    super!
    @SetRotten false
    @RotsIn = CurTime! + @RotTime if @RotTime > 0
    return

  Think: =>
    super!
    return if CLIENT
    @Rot! if @RotsIn and (not @GetRotten!) and @RotsIn < CurTime!

  Rot: =>
    @SetRotten true
    @SetColor Color(100, 0, 150)
    @EmitSound "FoodRot"

