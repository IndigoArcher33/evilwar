  level: SNDLVL_65DB

class Drink extends Food
  Sound: "DrinkFluid"

class FearBeer extends Drink
  PrintName: "Fear Beer"
  Model: Model"models/props_junk/garbage_glassbottle001a.mdl"
  Thirst: -12
  Despair: -15
  Description: "A bottle of foul off-yellow liquid.\n'BEER' is hand-written on the label."

  Price: 60

  TrashClass: "trash/bottle/fearbeer"

  ImpactThreshold: 256

  UseText: {
    "chugs a fear beer."
    "downs a bottle of piss beer."
    "drinks a ratty bottle of brew."
    "quaffs a beer and grimaces."
    "takes a swig of fear beer and shivers."
    "guzzles a fear beer."
    "chokes down some piss beer."
  }

  Initialize: =>
    super!
    @PrecacheGibs! if SERVER

  OnTakeDamage: (dmg) =>
    super dmg
    types = DMG_CLUB + DMG_SLASH + DMG_BULLET + DMG_CRUSH
    @Shatter(dmg\GetDamageForce!) if dmg\GetDamage! > 10 and dmg\IsDamageType(types)
    if attacker and IsValid(attacker) and attacker\IsPlayer!
      if attacker\HasOddity(ODDITY_DELINQUENCY)
        attacker\AddDespair(-math.random(2,4))

  PhysicsCollide: (data) =>
    super data
    return if CLIENT
    if data.Speed > @ImpactThreshold
      if data.HitEntity and IsValid(data.HitEntity)
        attacker = @GetNWEntity"evilrp_submitter"
        with dmg = DamageInfo!
          \SetDamage 25
          \SetAttacker attacker if IsValid(attacker)
          \SetInflictor @
          \SetDamageType DMG_SLASH
          \SetDamagePosition data.HitPos
          data.HitEntity\TakeDamageInfo dmg
      force = data.OurNewVelocity
      @Shatter force

  Shatter: (force) =>
    return if @broken
    @broken = true
    pos = @GetPos!
    for ply in *player.GetAll!
      continue unless ply\HasOddity(ODDITY_DELINQUENCY)
      if ply\CanSee(@) and ply\LookingInDirection(pos)
        ply\AddDespair(-math.random(2,4))
    with ed = EffectData!
      \SetStart pos
      \SetOrigin pos
      \SetScale 8
      util.Effect "GlassImpact", ed, true, true
    @EmitSound"BottleSmash"
    @GibBreakServer force
    @Remove!

