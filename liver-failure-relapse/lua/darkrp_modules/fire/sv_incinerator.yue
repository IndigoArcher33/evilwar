EVIL_INCINERATOR_BOUNDS = {
  ["rp_liverfailure_kidneydagger"]:
    * { Vector( 2296, 2905, -125 ), Vector( 2536, 2995, -307 ) }
}

next_incinerator_clear = CurTime!
incinerator_burn = ->
  map = game.GetMap!
  return unless EVIL_INCINERATOR_BOUNDS[map]
  bounds_list = EVIL_INCINERATOR_BOUNDS[map]
  ct = CurTime!
  if ct >= next_incinerator_clear
    next_incinerator_clear = ct + 1
    for bounds_pair in *bounds_list
      found = ents.FindInBox(bounds_pair[1], bounds_pair[2])
      for e in *found
        if e\GetNWBool"corpse" and not e\IsOnFire! and e\GetNWInt"decomp_stage" ~= DSTAGE_BONES
          e\Ignite(30)
          submitter = e\GetNWEntity"evilrp_submitter"
          if submitter and IsValid(submitter) and submitter\IsPlayer!
            if submitter\Team! == TEAM_SANITAR
              cells = e\GetNWInt"sanitar_cells"
              if cells and cells > 0
                submitter\AddStemCells(cells)
                e\SetNWInt("sanitar_cells", 0)

hook.Add "Think", "evilrp_incinerator_burn", incinerator_burn          
