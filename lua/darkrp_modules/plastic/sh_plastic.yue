class Submit_Polymer extends SOUND
  sound: ["physics/plastic/plastic_barrel_break#{i}.wav" for i=1,2]

class Polymer extends ITEM
  @__entity: "polymer"
  Spawnable: true

  PrintName: "Polymer"
  Model: Model"models/props_junk/garbage_plasticbottle002a.mdl"
  Category: "EvilWar: Precursor"
  Spawnable: true
  Interesting: true

  Sound: "physics/plastic/plastic_box_strain#{math.random(1, 2, 3)}.wav"

  SubmitSound: "Submit_Polymer"

  Submitted: =>
    pos = @GetPos!
    ed = EffectData!
    with ed
      \SetOrigin pos
      \SetScale 1
      \SetMagnitude 1
      \SetRadius 3
    util.Effect "Sparks", ed
    
  OnlyInventoryUse: false
    
  OnUseFinish: (ply) =>
    super ply
    dmg = DamageInfo!
    with dmg
      \SetDamage @BiteDamage
      \SetDamageType DMG_SLASH
      \SetAttacker ply
      \SetInflictor @
      \SetDamagePosition ply\EyePos!
    ply\TakeDamageInfo dmg
    @Remove!
      
class Nylon extends Polymer
  Model: Model"models/props_junk/plasticbucket001a.mdl"

  PrintName: "Nylon 666"
  Description: "Weapons-grade cancerplastic, ethically sourced."
  UseText: {
    "chokes on perfection."
    "cracks a molar on pure plastic."
    "lets the pure plastic melt in their stomach."
    "cracks their jaw on a hunk of polymer."
  }

  BiteDamage: 25
  CookTime: 5
  Precursor:
    polymer: 2


class Thermoplastic extends Polymer
  Model: Model"models/Items/CrossbowRounds.mdl"

  PrintName: "Thermoplastic"
  Description: "An extremely malleable piece of plastic.\nCan be cooked into a usable chunk."
  UseText: {
    "chokes on the plastic tubes."
    "doubled their chance of getting cancer."
    "hurts their mouth chewing on hard plastic."
  }

  BiteDamage: 34
  CookTime: 5


