hook.Add "Think", "evilrp_capsule_spawner", ->
  if CurTime! >= EVIL_NEXT_CAPSULE
    EVIL_NEXT_CAPSULE = CurTime! + EVIL_CAPSULE_DELAY + math.random(EVIL_CAPSULE_DELAY)
    capsules = ents.FindByClass"fleshcapsule"
    if #capsules < EVIL_CAPSULE_MAX
      positions = EVIL_CAPSULE_POSITIONS[game.GetMap!]
      pos = positions[math.random(#positions)]
      fleshcapsule = ents.Create"fleshcapsule"
      with fleshcapsule
        \SetPos pos
        \SetAngles Angle(math.random(360), math.random(360), math.random(360))
        \Spawn!
        \Activate!
        -- \EmitSound "ambient/machines/teleport3.wav", 100, 60 + math.random(20)
      SafeRemoveEntityDelayed fleshcapsule, 900
      
  return
