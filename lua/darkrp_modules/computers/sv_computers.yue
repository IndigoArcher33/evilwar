global GetPlayerByName = (name) ->
  return nil unless name and name != ""
  name = name\lower!
  for _, ply in pairs(player.GetAll!)
    if ply\Nick!\lower!\match name
        return ply
  return nil

global GetEtabByName = (name) ->   -- this will also check if there's any actually in stock
  return nil unless name and name != ""
  name = name\lower!
  for item, avail in pairs(GAMEMODE.Stocks)
    etab = scripted_ents.Get(item)
    unless etab
      -- it must be a SWEP
      etab = weapons.Get(item)
    
    if etab.PrintName\lower!\match(name) and avail > 0
      return etab
  
  return nil

