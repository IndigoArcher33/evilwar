  commands:
    [":help"]: {
      Callback: (ply, term, args) =>
        with gterm
          -- this sucks
          -- TODO: rewrite this to suck less
          \Broadcast term, "  COMMANDS:"
          for k, v in SortedPairs(@GetCommands!)
            \Broadcast term, "  * #{k}", GT_COL_INFO
            \Broadcast term, "    #{v.help}"
          \Broadcast term, "  end list", GT_COL_INTL
      help: "Basic usage instructions."
    }
    [":cls"]: {
      Callback: (ply, term) =>
        for i=0,term.max_lines
          time = math.Rand(0.01, 0.04)
          timer.Simple i * time, ->
            gterm\Broadcast(term, "", MSG_COL_NIL, i) if IsValid(term)
        return
      help: "Clear the screen."
    }
    [":advice"]: {
      Callback: (ply, term) =>
        advice = @advice[math.random(#@advice)]
        gterm\Broadcast(term, advice, MSG_COL_INFO) if IsValid(term)
      help: "Consult the infinite wisdom."
    }
    [":taxes"]: {
      Callback: (ply, term, args) =>
        taxes = GAMEMODE.taxes
        gterm\Broadcast term, "TAXES OF THE LAND:", GT_COL_INFO
        gterm\Broadcast term, "  #{k} tax is #{v}%", GT_COL_SUCC for k, v in pairs(taxes)
        gterm\Broadcast term, "end list", GT_COL_INTL
      help: "View what you people owe."
    }      
    [":laws"]: {
      Callback: (ply, term, args) =>
        laws = GAMEMODE\Laws!
        gterm\Broadcast term, "LAWS OF THE LAND:", GT_COL_INFO
