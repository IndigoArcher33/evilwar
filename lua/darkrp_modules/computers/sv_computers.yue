    "Burn your trash, eat your plastic, never stop smoking."
    "Liver Failure doesn't take kindly to slackers."
    "You live because you are useful enough to be exploited."
    "Chew with your good teeth."
    "Violence doesn't solve every problem, only some of them."
    "Flesh capsules are very delicate, be careful with them."
    "You do not need a gun. You do not want a gun."
    "Don't venture too far into the tunnels."
    "Evil things are bad."
    "Play catch with people."
    "Playing is fun."
    "Play teeth. Teeth is fun."
    "Rules are the rules."
    "M y  h e a d ... M y  b r a i n ... M y  b e e r ..."
    "Eat and drink before taking your medicine."
    "Bodily fluids can spread pathogens."
    "Your safety is not a priority."
    "It's what you wanted"
    "Radar spelled backwards is Radar."
    "You're thinking about it, aren't you?"
    "But seriously though,"
    "At least you're not dead yet."
    "At least you're not teeth yet."
    "I wanna go home."
    "Please"
    "You will get what you deserve."
    "Booze loves company."
    "Misery loves company."
    "Teeth love company."
    "Corpses love company."
    "The things you put in your mouth can hurt you."
    "Make sure you're ready for the hangover tomorrow."
    "Buying things feels so good, doesn't it?"
    "We work until we die, and that's the way we like it."
    "Blood brothers protect each other."
    "You can't trust that people are what they say."
    "Some people don't look like you. This is a problem."
    "What's a little brawl between friends?"
    "It's too late now."
    "you work to rent a bed so can rest for work tomorrow"
  }

  commands:
    [":help"]: {
      Callback: (ply, term, args) =>
        with gterm
          -- this sucks
          -- TODO: rewrite this to suck less
          \Broadcast term, "  COMMANDS:"
          for k, v in SortedPairs(@GetCommands!)
            \Broadcast term, "  * #{k}", GT_COL_INFO
            \Broadcast term, "    #{v.help}"
          \Broadcast term, "  end list", GT_COL_INTL
      help: "Basic usage instructions."
    }
    [":cls"]: {
      Callback: (ply, term) =>
        for i=0,term.max_lines
          time = math.Rand(0.01, 0.04)
          timer.Simple i * time, ->
            gterm\Broadcast(term, "", MSG_COL_NIL, i) if IsValid(term)
        return
      help: "Clear the screen."
    }
    [":advice"]: {
      Callback: (ply, term) =>
        advice = @advice[math.random(#@advice)]
        gterm\Broadcast(term, advice, MSG_COL_INFO) if IsValid(term)
      help: "Consult the infinite wisdom."
    }
    [":taxes"]: {
      Callback: (ply, term, args) =>
        taxes = GAMEMODE.taxes
        gterm\Broadcast term, "TAXES OF THE LAND:", GT_COL_INFO
        gterm\Broadcast term, "  #{k} tax is #{v}%", GT_COL_SUCC for k, v in pairs(taxes)
        gterm\Broadcast term, "end list", GT_COL_INTL
      help: "View what you people owe."
    }      
    [":laws"]: {
      Callback: (ply, term, args) =>
        laws = GAMEMODE\Laws!
        gterm\Broadcast term, "LAWS OF THE LAND:", GT_COL_INFO
        gterm\Broadcast term, "  #{k}. #{v}", GT_COL_WRN for k, v in ipairs(laws)
        gterm\Broadcast term, "end list", GT_COL_INTL
      help: "View the laws of this land."
    }
    [":whoami"]: {
      Callback: (ply, term, args) =>
        gterm\Broadcast term, "this experimental feature is still in testing", GT_COL_WRN
        gterm\Broadcast term, "try later", GT_COL_WRN
      help: "View social information."
    }

  lifetime: 60 * 3
  Initialized: (term) =>
    super term
    term.live_until = CurTime! + @lifetime
    gterm\Broadcast term, "DEATH when idle time exceeds #{string.NiceTime(@lifetime)}", GT_COL_INFO
  ReceiveInput: (term, ply) =>
    term.live_until = CurTime! + @lifetime
  Think: (term) =>
    ct = CurTime!
    return unless term\GetActive!
    return if term.warn_cooldown and ct < term.warn_cooldown
    term.live_until = ct + @lifetime unless term.live_until
    time_left = term.live_until - CurTime!
    if math.floor(time_left) % 60 == 0 -- every minute
      if math.floor(time_left) <= 1
        gterm\Broadcast term, "DEATH", GT_COL_INTL
        timer.Simple math.Rand(2,5), ->
          if IsValid(term) and term\GetActive!
            for i=0,term.max_lines
              gterm\Broadcast term, "", nil, i if IsValid(term)
            gterm.OS\Call term, "ShutDown"
      else
        gterm\Broadcast term, "DEATH in #{string.NiceTime(time_left)}", GT_COL_INFO
    
net.Receive "evilrp_terminal_endconsole", (len, ply) ->
  idx = net.ReadUInt(16)
  term = Entity(idx)
  text = net.ReadString!
  return unless (IsValid(term) and term.GetUser)
  user = term\GetUser!
  return unless (IsValid(user) and user == ply)
  if (text == "") or (text == " ")
    term\SetUser nil
    net.Start"evilrp_terminal_endtyping"
    net.Send ply
    return
  gterm.OS\Call term, "ReceiveInput", ply
  if term.password and not client["pass_authed_#{idx}"]
    if text == term.password
      ply["pass_authed_#{idx}"] = true
      gterm\Broadcast term, "password accepted", GT_COL_INFO
      return
    else
      gterm\Broadcast term, "password required", GT_COL_INFO
      return
  if string.sub(text, 1, 1) == ":"
    sys = OS.distros[term\GetOS!]
    if sys
      for k, v in pairs sys\GetCommands!
        cmd = string.sub(string.lower(text), 1, string.len(k))
        if k == cmd
          text2 = string.sub(text, string.len(cmd) + 2)
          quote = (string.sub(text2, 1, 1) ~= "\"")
          args = {}
          for chunk in string.gmatch(text2, "[^\"]+")
            quote = not quote
            if quote
              args[] = chunk
            else
              args[] = chunk for chunk in string.gmatch(chunk, "[^ ]+")
          success, value = pcall v.Callback, sys, ply, term, args
          if success
            gterm\Broadcast term, text, GT_COL_CMD
          else
            gterm\Broadcast term, value, GT_COL_ERR
          return
      text = "#{string.sub(text, 2)}: command not found"
      gterm\Broadcast term, text, GT_COL_ERR
      return
    else
      -- fatal error that shouldn't happen, but if it does, it should
      -- scare the hell out of the poor bastards who see it
      gterm\Broadcast term, "DEATH", GT_COL_INTL
    if term.accepting_input
      quote = (string.sub(text, 1, 1) ~= "\"")
      args = {}
      for chunk in string.match(text, "[^\"]+")
        quote = not quote
        if quote
          args[] = chunk
        else
          args[] = chunk for chunk in string.gmatch(chunk, "[^ ]+")
      callback = term.input_callback
      callback(ply, args) if callback and args
      term.accepting_input = nil
      term.input_callback = nil
      return
  sys = OS.distros[term\GetOS!]
  name = sys and sys.unique_id or "unknown"
  finalized = "#{"<"\Escape!}#{name}@#{term\EntIndex!}#{">"\Escape!} #{text}"
  gterm\Broadcast(term, finalized, GT_COL_CMD)

MsgC Color(255,0,0), "INITIALIZED EVILRP TERMINALS\n"
