        gterm\Broadcast term, "end list", GT_COL_INTL
      help: "View the laws of this land."
    }
    [":nation"]: {
      Callback: (ply, term, args) =>
        if ply\Team! ~= TEAM_EMPEROR
          gterm\Broadcast term, "begone with you", GT_COL_ERR
          return
        cmd = args[1]
        switch cmd
          when "info"
            nation = args[2]\lower! unless args[2] == ""
            found = false
            for k, v in pairs GAMEMODE.War.nations
              if v.Name\lower!\match nation
                found = true
                troops = v.Troops / math.random(4, 8)
                troops = v.Troops * math.random(4, 8)  if k == "Lymphoma"
                troops = math.floor troops
                gterm\Broadcast term, "========== The #{v.Name} ==========", GT_COL_INFO
                gterm\Broadcast term, "  #{v.Description}"
                gterm\Broadcast term, "  Troops: #{troops}", GT_COL_INFO
                gterm\Broadcast term, "  Cities:", GT_COL_INFO
                for c in *v.Cities
                  gterm\Broadcast term, "    #{c\Print!}"
                return
            unless found
              gterm\Broadcast term, "pick a correct nation", GT_COL_ERR
              return
          when "list"
            argument = args[2]
            verbose = false
            if argument == "verbose"
              verbose = true
            
            gterm\Broadcast term, "ENEMIES OF THE LAND:", GT_COL_INFO
            for k, v in pairs GAMEMODE.War.nations
              troops = v.Troops / math.random(4, 8)
              troops = v.Troops * math.random(4, 8)  if k == "Lymphoma"
              troops = math.floor troops
              gterm\Broadcast term, "  #{v.Name} - Troops: #{troops}" 
              op = GAMEMODE.War.active_operation
              if verbose and op and op.Defender == v
                gterm\Broadcast term, "     > #{op.Name} - BoP: #{op.Balance}", GT_COL_INFO
            gterm\Broadcast term, "end list", GT_COL_INTL
            return
          else
            with gterm
              \Broadcast term, "NATIONS INTERFACE", GT_COL_INFO
              \Broadcast term, "  INFO:", GT_COL_INFO
              \Broadcast term, "    lymphoma is the only thing that matters, it's better to stay informed about those who seek to destroy it"
              \Broadcast term, "  HELP:", GT_COL_INFO
              \Broadcast term, "    :nation info TARGET - stay informed about the status of a specific enemy"
              \Broadcast term, "    :nation list - know your neighbors"
              \Broadcast term, "    :nation list verbose - know your neighbors, and everything they possess"
      help: "Know your enemies."
    }
    [":whoami"]: {
      Callback: (ply, term, args) =>
        gterm\Broadcast term, "this experimental feature is still in testing", GT_COL_WRN
        gterm\Broadcast term, "try later", GT_COL_WRN
      help: "View social information."
    }

  lifetime: 60 * 3
  Initialized: (term) =>
    super term
    term.live_until = CurTime! + @lifetime
    gterm\Broadcast term, "DEATH when idle time exceeds #{string.NiceTime(@lifetime)}", GT_COL_INFO
  ReceiveInput: (term, ply) =>
    term.live_until = CurTime! + @lifetime
  Think: (term) =>
    ct = CurTime!
    return unless term\GetActive!
    return if term.warn_cooldown and ct < term.warn_cooldown
    term.live_until = ct + @lifetime unless term.live_until
    time_left = term.live_until - CurTime!
    if math.floor(time_left) % 60 == 0 -- every minute
      if math.floor(time_left) <= 1
        gterm\Broadcast term, "DEATH", GT_COL_INTL
        timer.Simple math.Rand(2,5), ->
          if IsValid(term) and term\GetActive!
            for i=0,term.max_lines
              gterm\Broadcast term, "", nil, i if IsValid(term)
            gterm.OS\Call term, "ShutDown"
      else
        gterm\Broadcast term, "DEATH in #{string.NiceTime(time_left)}", GT_COL_INFO
    
net.Receive "evilrp_terminal_endconsole", (len, ply) ->
  idx = net.ReadUInt(16)
  term = Entity(idx)
  text = net.ReadString!
  return unless (IsValid(term) and term.GetUser)
  user = term\GetUser!
  return unless (IsValid(user) and user == ply)
  if (text == "") or (text == " ")
    term\SetUser nil
    net.Start"evilrp_terminal_endtyping"
    net.Send ply
    return
  gterm.OS\Call term, "ReceiveInput", ply
  if term.password and not client["pass_authed_#{idx}"]
    if text == term.password
      ply["pass_authed_#{idx}"] = true
      gterm\Broadcast term, "password accepted", GT_COL_INFO
      return
    else
      gterm\Broadcast term, "password required", GT_COL_INFO
      return
  if string.sub(text, 1, 1) == ":"
    sys = OS.distros[term\GetOS!]
    if sys
      for k, v in pairs sys\GetCommands!
        cmd = string.sub(string.lower(text), 1, string.len(k))
        if k == cmd
          text2 = string.sub(text, string.len(cmd) + 2)
          quote = (string.sub(text2, 1, 1) ~= "\"")
          args = {}
          for chunk in string.gmatch(text2, "[^\"]+")
            quote = not quote
            if quote
              args[] = chunk
            else
              args[] = chunk for chunk in string.gmatch(chunk, "[^ ]+")
          success, value = pcall v.Callback, sys, ply, term, args
          if success
            gterm\Broadcast term, text, GT_COL_CMD
          else
            gterm\Broadcast term, value, GT_COL_ERR
          return
      text = "#{string.sub(text, 2)}: command not found"
      gterm\Broadcast term, text, GT_COL_ERR
      return
    else
      -- fatal error that shouldn't happen, but if it does, it should
      -- scare the hell out of the poor bastards who see it
      gterm\Broadcast term, "DEATH", GT_COL_INTL
    if term.accepting_input
      quote = (string.sub(text, 1, 1) ~= "\"")
      args = {}
      for chunk in string.match(text, "[^\"]+")
        quote = not quote
        if quote
          args[] = chunk
        else
          args[] = chunk for chunk in string.gmatch(chunk, "[^ ]+")
      callback = term.input_callback
      callback(ply, args) if callback and args
      term.accepting_input = nil
      term.input_callback = nil
      return
  sys = OS.distros[term\GetOS!]
  name = sys and sys.unique_id or "unknown"
  finalized = "#{"<"\Escape!}#{name}@#{term\EntIndex!}#{">"\Escape!} #{text}"
  gterm\Broadcast(term, finalized, GT_COL_CMD)

net.Receive "evilrp_terminal_scroll", (len, ply) ->
  idx = net.ReadUInt(16)
  dir = net.ReadInt(4) -- 1 arrow up, -1 arrow down
  term = Entity(idx)
  print(dir)
  print(term)

  return unless IsValid(term) and term.GetUser
  user = term\GetUser!
  return unless IsValid(user) and user == ply
  
  term.history or= {}
  maxlines = term.max_lines or 25
  term.offset or= 0
  
  if dir == 1
    term.offset += 1
  elseif dir == -1
    term.offset -= 1
    
  maxscroll = math.max(0, #term.history - maxlines)
  term.offset = math.Clamp(term.offset, 0, maxscroll)
  
  for i=0, maxlines
    gterm\Broadcast term, "", GT_COL_NIL, i
    
  start = #term.history - maxlines - term.offset + 1
  start = math.max(1, start)
  
  pos = 0
  for i=start, start + maxlines - 1
    line = term.history[i]
    if line
      gterm\Broadcast term, line.msg, line.col, pos
    pos += 1

MsgC Color(255,0,0), "INITIALIZED EVILRP TERMINALS\n"


