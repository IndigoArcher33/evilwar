ammo_check_bind = (ply, bind, down) ->
  lp = LocalPlayer!
  lpw = LocalPlayer!\GetActiveWeapon!
  if (down and string.find(bind, "+reload") and lp\KeyDown(IN_USE))
    if (lpw and lpw\IsValid! and lpw ~= NULL)
      if not (lpw.Firearm == true)
        print("miaow")
        return true
      else
        lpw\CheckAmmo!
  return
    
hook.Add "PlayerBindPress", "evilrp_weapon_ammocheck", ammo_check_bind
