class Crowbar extends EvilRP_Melee
  PrintName: "Crowbar"
  Description: "Check out the teeth on this thing.\nThey're stronger than yours."
    
  Slot: 0

  Price: 150
    
  Spawnable: true
  UseHands: true

  ViewModelFOV: 54

  ViewModel: Model("models/weapons/c_crowbar.mdl")
  WorldModel: Model("models/weapons/w_crowbar.mdl")

  HoldType: "melee"
  LowerHoldType: "normal"
    
  Primary: {
    ChargeTime: 0.4

    Light: {
      Damage: 24
      DamageType: DMG_CLUB

      Range: 75
      Delay: 0.4

      Act: {ACT_VM_HITCENTER, ACT_VM_MISSCENTER}

      Sound: {"Weapon_Crowbar.Melee_Hit", "Weapon_Crowbar.Single"}
    },

    Heavy: {
      Damage: 40
      DamageType: DMG_CLUB

      Range: 100
      Delay: 1

      Act: ACT_VM_MISSCENTER

      Sound: {"Weapon_Crowbar.Melee_Hit", "Weapon_Crowbar.Single"}
    }
  }

  ChargeOffset: {
    Pos: Vector -15, 0, -10
    Ang: Angle -35, 0, 0
  }

