class Reload_Shell extends SOUND
  sound: ["weapons/shotgun/shotgun_reload#{i}.wav" for i=1,3]

class Candlewood_Fire extends SOUND
  sound: "tekka/weapons/weapon_warhammer.wav"
  chan: CHAN_WEAPON

class Candlewood extends EvilRP_Weapon 
  PrintName: "Candlewood"
  Description: "An unwieldy pump-action shotgun.\nRust is eating it alive."

  Slot: 1
    
  Spawnable: true
    
  UseHands: true
  ViewModelTargetFOV: 54
  ViewModel: Model"models/weapons/c_candlewood.mdl"
  WorldModel: Model"models/weapons/w_candlewood.mdl"
    
  HoldType: "shotgun"
  LowerHoldType: "passive"
    
  Firemode: 0
  Primary: {
    Ammo: "Buckshot"

    ClipSize: 4
    DefaultClip: 8

    Damage: 17
    PumpAction: false -- confusingly this must be false, because the animations
                      -- are from CS:S
    Pump:
      Delay: 0.4
      Sound: "weapons/shotgun/shotgun_cock.wav"
      FromEmpty: true
      
    Count: 7
    Delay: -1

    Range: 400
    Accuracy: 12

    RangeModifier: 0.7

    Recoil: {
      MinAng: Angle(10, -2, 0)
      MaxAng: Angle(14, 2, 0)
      Punch: 0.9
      Ratio: 0.8
    }
        
    Reload: {
      Amount: 1
      Sound: "Reload_Shell"
      Shotgun: true
    }
      
    Sound: "Candlewood_Fire"
    TracerName: "Tracer"
  }
    
