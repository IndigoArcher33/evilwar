global EVIL_MACHINE_POSITIONS_CURSED = {
  ["rp_liverfailure_kidneydagger"]:
    * machine:
        pos: Vector(3958, 393, 100)
        ang: Angle(0, 94, 0)
      generator:
        pos: Vector(3864, 513, 65)
        ang: Angle(0, 19, 0)
    * machine:
        pos: Vector(3986, 4822, 101)
        ang: Angle(0, -176, 0)
      generator:
        pos: Vector(3965, 4708, 66)
        ang: Angle(0, -104, 0)
    * machine:
        pos: Vector(2412, 3078, 148)
        ang: Angle(0, -90, 0)
      generator:
        pos: Vector(2307, 2830, 113)
        ang: Angle(-0, 135, 0)
    * machine:
        pos: Vector(-142, 1584, 365)
        ang: Angle(-0, -91, 1)
      generator:
        pos: Vector(-14, 1617, 329)
        ang: Angle(-0, -6, -0)
    * machine:
        pos: Vector(3584, 795, -364)
        ang: Angle(-0, 180, -0)
      generator:
        pos: Vector(3586, 843, -399)
        ang: Angle(-0, -18, 1)
    * machine: 
        pos: Vector(1977, -380, 100)
        ang: Angle(-0, -1, 1)
      generator:
        pos: Vector(2251, -374, 65)
        ang: Angle(-0, 117, -0)
}

create_machines_and_otherwise = ->
  EVIL_GENERATOR_POSITIONS = {
    ["rp_lymphoma"]:
      * pos: Vector( -972, 1153, 1 )
        ang: Angle(-0, 0, -0)
        id: "tools"
      * pos: Vector( 209, 2618, 1 )
        ang: Angle(-0, -47, -0)
        id: "food"
      * pos: Vector( 256, 289, 193 )
        ang: Angle( -0, 90, 0 )
        id: "weapons"
      * pos: Vector( 1529, 769, 1 )
        ang: Angle(-0, -0, 0)
        id: "medicine"
      * pos: Vector(3041, 1784, -103)
        ang: Angle(8, 126, 0)
        id: "evil"
    }
  EVIL_MACHINE_POSITIONS = {
    ["rp_lymphoma"]:
      * pos: Vector( -1104, 1264, 36 )
        ang: Angle(-0, -180, 0)
        cls: "machine/tools"
      * pos: Vector( -1104, 1461, 36 )
        ang: Angle(-0, -180, 0)
        cls: "machine/tools"
      * pos: Vector( -277, 2704, 36 )
        ang: Angle(-0, -90, 0)
        cls: "machine/food"
      * pos: Vector( -146, 2704, 36 )
        ang: Angle(-0, -90, 0)
        cls: "machine/food"
      * pos: Vector( -10, 2705, 37 )
        ang: Angle(-0, -90, 0)
        cls: "machine/food"
      * pos: Vector( 592, 275, 228 )
        ang: Angle(-0, -180, -0)
        cls: "machine/weapons"
      * pos: Vector( 592, 400, 228 )
        ang: Angle(-0, -180, -0)
        cls: "machine/weapons"
      * pos: Vector( 1712, 736, 36 )
        ang: Angle(-0, -180, 0)
        cls: "machine/medicine"
      * pos: Vector( 1712, 548, 36 )
        ang: Angle(-0, -180, 0)
        cls: "machine/medicine"
      * pos: Vector(3003, 1774, -103)
        ang: Angle(19, 173, 0)
        cls: "machine/evil"
      * pos: Vector( 323, 2401, 28 )
        ang: Angle(-0, 90, 0)
        cls: "refinery"
      * pos: Vector( 323, 2147, 28 )
        ang: Angle(0, 90, -0)
        cls: "refinery"
      * pos: Vector( -354, 2399, 28 )
        ang: Angle(-0, -90, -0)
        cls: "refinery"
      * pos: Vector( -1292, 1508, 28 )
        ang: Angle(0, 180, -0)
        cls: "refinery"
      * pos: Vector( -575, 538, 48 )
        ang: Angle(0, 0, 0)
        cls: "cooker"
      * pos: Vector( -575, 494, 48 )
        ang: Angle(0, 0, 0)
        cls: "cooker"
      * pos: Vector( 573.55, -3365.23, -815 )
        ang: Angle(0, -180, 0)
        cls: "cooker"
  }
  map = game.GetMap!
  for gen in *ents.FindByClass"generator"
    gen\Remove!
  if EVIL_GENERATOR_POSITIONS[map]
    for v in *EVIL_GENERATOR_POSITIONS[map]
      sp = ents.Create"generator"
      with sp
        \SetPos v.pos
        \SetAngles v.ang
        \SetFactoryIdentifier v.id
        \Spawn!
        \Activate!
        \GetPhysicsObject!\EnableMotion false
      MsgC Color(0, 200, 0),
        "#{sp} spawned with factory identifier '",
        Color(200, 200, 200),
        v.id,
        Color(0, 200, 0),
        "'.\n"
    -- this is nested inside the if condition for generator positions
    -- existing for a particular map, because machines shouldn't be
    -- spawned if there are no generators to support them.  though,
    -- strictly speaking, there shouldn't be one without the other in
    -- any case
    for mach in *ents.FindByClass"machine/*"
      mach\Remove!
    for ref in *ents.FindByClass"refinery"
      ref\Remove!
    timer.Simple 1, ->
      if EVIL_MACHINE_POSITIONS[map]
        for v in *EVIL_MACHINE_POSITIONS[map]
          sp = ents.Create v.cls
          with sp
            \SetPos v.pos
            \SetAngles v.ang
            \Spawn!
            \Activate!
            phys = \GetPhysicsObject!
            phys\EnableMotion false if IsValid(phys)
            MsgC Color(0, 200, 0),
              "#{sp} spawned.\n"
      if EVIL_MACHINE_POSITIONS_CURSED[map]
        sp = ents.Create "machine/evil"
        with sp
          \Spawn!
          \Activate!
          phys = \GetPhysicsObject!
          phys\EnableMotion false if IsValid(phys)
          MsgC Color(200, 0, 0),
            "#{sp} SPAWNED.\n"
          \Shift!
      return

hook.Add "InitPostEntity", "evilrp_create_machines_and_otherwise", create_machines_and_otherwise
