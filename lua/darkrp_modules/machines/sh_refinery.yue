noise = Material"models/props_lab/eyescanner_disp"
screen = Material"glass/glasswindow017a"

class Refinery extends ENTITY
  Base: "base_anim"
  Type: "anim"
  PrintName: "Refinery"
  Interesting: true

  Spawnable: true
  AdminSpawnable: true

  Pocketable: false

  SetupDataTables: =>
    @NetworkVar "String", "Producing"
    @NetworkVar "Int", "ProductionStart"
    @NetworkVar "Int", "ProductionEnd"
    @NetworkVar "Int", "SoundLoop"
    @NetworkVar "Int", "Rust"
    @NetworkVar "Int", "Heat"
    @NetworkVar "Entity", "Worker"

  Initialize: =>
    return if CLIENT
    @SetUseType SIMPLE_USE
    @SetModel"models/props_wasteland/laundry_washer003.mdl"
    @PhysicsInit SOLID_VPHYSICS
    @PhysWake!
    @SetHeat 0
    @NextHeat = 0

  Think: =>
    return if CLIENT
    pend = @GetProductionEnd!
    ct = CurTime!
    rust = @GetRust!
    if pend > 0 and ct >= pend
      prod = scripted_ents.Get(@GetProducing!).Refinement
      @SetRust math.min(100, rust + (prod.rust or prod.time))
      @EmitSound"buttons/lever6.wav"
      @StopLoopingSound @GetSoundLoop!
      worker = @GetWorker!
      if worker and IsValid worker
        start = @GetPos!
        endpos = start + (@GetUp! * 128) + (@GetForward! * 24)
        tr = util.TraceLine{
          :start
          :endpos
          filter: @
          mask: MASK_NPCWORLDSTATIC
        }
        if prod.result
          wep = weapons.Get(prod.result)
          if wep
            sp = ents.Create"evilrp/spawned/weapon"
            with sp
              \SetPos tr.HitPos - (@GetUp! * 86) - (@GetForward! * 38) - (@GetRight! * 8)
              \SetModel wep.WorldModel
              \SetWeaponClass prod.result
              \Spawn!
              \Activate!
          else
            sp = ents.Create prod.result
            with sp
            
              \SetPos tr.HitPos - (@GetUp! * 86) - (@GetForward! * 38) - (@GetRight! * 8)
              \Spawn!
              \Activate!
        -- implement heat here
        -- implement rust explosions here
        @SetWorker nil
      @SetProducing""
      @SetProductionStart 0
      @SetProductionEnd 0
    -- implement heat increasing and lowering here

  Touch: (what) =>
    if SERVER
      if what.Rust
        @SetRust math.Clamp(@GetRust! + what.Rust, 0, 100)
        @EmitSound"ambient/machines/machine1_hit1.wav"
        pos = what\GetPos!
        ed = EffectData!
        with ed
          \SetOrigin pos
          \SetScale 1
          \SetMagnitude 1
          \SetRadius 3
        util.Effect "Sparks", ed
        what\Trash!
        return
      return if @GetProductionEnd! > 0
      return unless what.Refinement
      prod = what.Refinement
      submitter = what\GetNWEntity("evilrp_submitter")
      return unless submitter and IsValid(submitter)
      return if what.Processed
      what.Processed = true
      what\Submitted! if what.Submitted
      what\EmitSound what.SubmitSound if what.SubmitSound
      @SetProducing what\GetClass!
      ct = CurTime!
      @SetProductionStart ct
      wait = prod.time * (1 + (@GetRust! / 100))
      @SetProductionEnd ct + wait
      @SetWorker submitter
      @EmitSound"ambient/machines/machine1_hit1.wav"
      @SetSoundLoop @StartLoopingSound"ambient/machines/machine_whine1.wav"
      ed = EffectData!
      with ed
        \SetStart @GetPos!
        \SetOrigin @GetPos!
        \SetScale 2
      util.Effect "StunstickImpact", ed, true, true
      what\Remove!
        
  OnTakeDamage: (dmg) =>
    attacker = dmg\GetAttacker!
    if attacker and IsValid(attacker)
      if attacker\IsPlayer!
        switch attacker\Team!
          when TEAM_KORPSMAN, TEAM_CONSCRIPT
            rust = @GetRust!
            @SetRust math.max(0, rust - (dmg\GetDamage! * .2))
            reward = math.floor(math.abs(rust - @GetRust!) * 2.3)
            if reward > 0
              attacker\AddMoney reward, "The Cleansing"
              attacker\SetHealth attacker\Health! + 2
              
  Draw: =>
    @DrawModel!
    @Render3D2D!

  HUDRender: =>
    ct = {}
    ct[] = @PrintName
    ct[] = {
      text: "Certain items can be processed into more useful things with this."
      font: "Spleen_Label_Small"
    }
    ct[] = {
      text: "The rustier it is, the longer it will take."
      font: "Spleen_Label_Small"
    }
    return ct

  Render3D2D: =>
    dist_sqr = @GetPos!\DistToSqr(lp\GetPos!)
    return unless dist_sqr < 128^2
    font = "Spleen_Label"
    desp = lp\GetDespair! * 0.01
    ct = CurTime!
    pos = @GetPos! + (@GetUp! * 15) + (@GetForward! * 25) + (@GetRight! * -20)
    ang = @GetAngles!
    with ang
      \RotateAroundAxis \Up!, -90
      \RotateAroundAxis \Forward!, 90
      \RotateAroundAxis \Right!, 90
    -- 3D2D start: name
    cam.Start3D2D pos, ang, 0.1
    -- draw a rectangle, on which to draw the text atop
    surface.SetMaterial noise
    surface.SetDrawColor Color(255,255,255,255)
    surface.DrawTexturedRect 0, 0, 152, 38
    -- render the name
    txt = "Refinery"
    txt_obj = scribe.Parse "<stutter><rgb=1,1,30><wiggle=#{8 * desp},#{10 * desp}><f=#{font}><wave=#{6 * desp},#{0.38 * desp},2><ol=2>#{txt}"
    txt_obj\Draw 8, 6, 1, TEXT_ALIGN_LEFT
    -- 3D2D end
    cam.End3D2D!
    -- 3D2D start: rust
    pos = @GetPos! + (@GetUp! * 5) + (@GetForward! * 25) + (@GetRight! * -22)
    cam.Start3D2D pos, ang, 0.1
    rust = @GetRust!
    txt = "#{rust}% rust"
    if rust < 0
      txt = "give me purpose"
    elseif rust >= 100
      txt = "100% ROTTEN"
    pend = @GetProductionEnd!
    pstart = @GetProductionStart!
    prod = @GetProducing!
    if pend > 0 and prod
      prod = scripted_ents.Get prod
      text = prod.PrintName if prod
    surface.SetDrawColor 0, 0, 0, 255
    surface.DrawRect 0, 0, 152, 78
    if pend > 0
      cur = ct - pstart
      surface.SetDrawColor 0, 150 + (100 * math.cos(ct)), 0, 255
      surface.DrawRect 0, 0, 152 * (cur / (pend - pstart)), 78
    elseif rust >= 100
      surface.SetDrawColor 150 + (100 * math.cos(ct)), 0, 0, 255
      surface.DrawRect 0, 0, 152 * (rust / 100), 78
    else
      surface.SetDrawColor 147, 58 + (2 * math.cos(ct)), 22, 255
      surface.DrawRect 0, 0, 152 * (rust / 100), 78
    txt_obj = scribe.Parse "<stutter><rgb=1,1,30><wiggle=#{8 * desp},#{10 * desp}><f=#{font}><wave=#{6 * desp},#{0.38 * desp},2><ol=2>#{txt}"
    txt_obj\Draw 76, 24, 1, TEXT_ALIGN_CENTER
    cam.End3D2D!
    
