button1 = Material("icon16/exclamation.png")
button2 = Material("icon16/cancel.png")
button3 = Material("icon16/delete.png")
default_button = Material("sprites/glow04_noz_gmod")
default0 = Material("sprites/glow04_noz")

colors = {
  Color(150, 150, 150)
  Color(0, 255, 0)
  Color(0, 0, 255)
}

