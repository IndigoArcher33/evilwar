        wood: 2
      time: 30 }

  ProduceItem: (item) =>
    -- the evil machine drops items directly
    etab = scripted_ents.Get(item)
    local weapon
    unless etab
      -- it must be a SWEP
      etab = weapons.Get(item)
      weapon = true
    local product
    if weapon
      product = ents.Create"evilrp/spawned/weapon"
      with product
        \SetModel etab.WorldModel
        \SetWeaponClass item
    else
      product = ents.Create item
    product\SetPos(@GetPos! + Vector(0,0,-12) + (@GetForward! * 8))
    product\Spawn!
    product\Activate!
    @EmitSound"Evil_Squeal"
    return product

  Shift: =>
    return unless SERVER
    map = game.GetMap!
    return unless EVIL_MACHINE_POSITIONS_CURSED[map]
    positions_all = {...EVIL_MACHINE_POSITIONS_CURSED[map]}
    positions = {}
    -- hacky way of building this
    our_pos = @GetPos!
    for k, v in pairs(positions_all)
      unless our_pos == v.machine.pos
        positions[] = v
    where = positions[math.random(#positions)]
    where_mach = where.machine
    where_gen = where.generator
    @EmitSound"Evil_Squeal"
    @SetPos(where_mach.pos)
    @SetAngles(where_mach.ang)
    gen = @GetGenerator!
    with gen
      \SetPos(where_gen.pos)
      \SetAngles(where_gen.ang)
      \SetRust(0)
      \SetFuel(0)
      if \GetOn!
        \SetOn false
        \StopLoopingSound \GetSoundLoop!
        .Overload = false
    @PositionButtons!
    @SetRust(0)
    MsgC Color(200,0,0), "The evil machine shifted.\n"

  Think: =>
    super!
    ct = CurTime!
    @next_shift = ct + 5 unless @next_shift
    if ct >= @next_shift
      if @GetProducing! == ""
        @next_shift = ct + math.random(300,900)
        @Shift!

  FactoryIdentifier: "evil"
