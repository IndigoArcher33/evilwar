global EVIL_NEXT_TREE = 0
EVIL_TREE_DELAY = 40
EVIL_TREE_MAX = 7
global EVIL_TREES = {}
EVIL_TREE_POSITIONS = {
  ["rp_liverfailure_kidneydagger"]: {
    Vector(2549, -349, 72)
    Vector(2600, -119, 72)
    Vector(1528, 1183, -143)
    Vector(2768, 2075, -143)
    Vector(2090, 2067, -143)
    Vector(1540, 776, -143)
    Vector(255, 3507, 49)
    Vector(95, 3403, 49)
    Vector(3, 3538, 49)
    Vector(-154, 3459, 49)
  }
  ["rp_lymphoma"]: {
    Vector( 237, -2625, -176 )
    Vector( 731, -3127, -128 )
    Vector( 531, -3652, -119 )
    Vector( 20, -4488, -220 )
    Vector( -881, -4079, -170 )
    Vector( -631, -3275, -213 )
    Vector( 261, 1893, -79 )
    Vector( 343, 1862, -79 )
    Vector( -197, 1973, -79 )
    Vector( -242, 1874, -79 )
    Vector( -322, 1898, -79 )

  }
}

hook.Add "Think", "evilrp_tree_spawner", ->
  if CurTime! >= EVIL_NEXT_TREE
    EVIL_NEXT_TREE = CurTime! + EVIL_TREE_DELAY + math.random(EVIL_TREE_DELAY)
    trees = ents.FindByClass"tree"
    if #trees < EVIL_TREE_MAX
      positions = EVIL_TREE_POSITIONS[game.GetMap!]
      pos = positions[math.random(#positions)]
      tree = ents.Create"tree"
      with tree
        \SetPos pos
        \Spawn!
        \Activate!      
        \GetPhysicsObject!\EnableMotion false
  return
