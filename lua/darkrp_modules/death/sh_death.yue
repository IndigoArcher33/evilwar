GAMEMODE.Deaths = -> GetGlobalInt"DEATH"

class KOMDEATH extends SOUND
  level: SNDLVL_NONE
  sound: "kidneydagger/deadkommandant.ogg"


emperor_death = (ply) ->
  return unless ply\Team! == TEAM_EMPEROR
  Chat.Announce("GENERIC","<c=230,0,0>The EMPEROR is dead. Long live the EMPEROR.")
  ply\EmitSound"KOMDEATH"

death = (ply) ->
  deaths = GAMEMODE.Deaths! + 1
  SetGlobalInt "DEATH", deaths
  bodies = "BODIES"
  bodies = "BODY" if deaths == 1

  if ply\Team! == TEAM_EMPEROR
    emperor_death ply
  job = RPExtraTeams[ply\Team!]
  if job.cooldown and job.cooldown > 0
    ply.cooldowns or= ply.cooldowns or {}
    ply.cooldowns[ply\Team!] = CurTime! + job.cooldown


  RunConsoleCommand "hostname", "#{string.english_number(deaths)\upper!} DEAD #{bodies} TODAY"


hook.Add "DoPlayerDeath", "evilrp_death", death
