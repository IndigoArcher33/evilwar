
global conscript = (ply) ->
  return unless ply\Team! == TEAM_PRIVATE
  fate = TEAM_CONSCRIPT
  ply\Notify"<c=200,0,0> WAR IS HELL"
  ply\AddMoney 100
  ply\AddDespair -20
  ply\ScreenFade(SCREENFADE.IN, Color(255, 0, 0), 2.5, 0)
  ply\changeTeam(fate)
  snd = table.Random(RPExtraTeams[fate].become_sounds)
  ply\EmitSound(snd)
  ply\EmitSound("npc/stalker/go_alert2.wav", 140, 40, 0.2)

