import random from math

class Boulder extends ENTITY
  Base: "base_anim"
  Type: "anim"
  Spawnable: true
  AdminSpawnable: true

  Pocketable: false

  LootTable:
    * "metal/scrap"
    * "metal/slag"
    
  SetupDataTables: =>
    @NetworkVar "Int", 0, "Integrity"
      
  Initialize: =>
    @MaxIntegrity = 200
    return if CLIENT
    mdls = {"models/props_wasteland/rockgranite03a.mdl"
      "models/props_wasteland/rockgranite03b.mdl"
      "models/props_wasteland/rockgranite03c.mdl"}
    mdl = mdls[math.random(#mdls)]
    @SetModel mdl
    @PhysicsInit SOLID_VPHYSICS
    @SetIntegrity @MaxIntegrity
    with phys = @GetPhysicsObject!
      \Wake! if phys and IsValid(phys)
        
  OnTakeDamage: (dmg) =>
    @TakePhysicsDamage dmg
    dtype = dmg\GetDamageType!
    return unless (dtype == DMG_CLUB) or (dtype == DMG_BLAST)
    dmg_int = dmg\GetDamage!
    inflictor = dmg\GetInflictor!
    dmg_int *= inflictor.MineBonus if inflictor.MineBonus
    pos = dmg\GetDamagePosition!
    with edata = EffectData!
      \SetOrigin pos
      \SetScale 1
      \SetMagnitude 0.5
      \SetRadius 2
      util.Effect "Sparks", edata
        
    @SetIntegrity @GetIntegrity! - dmg_int
    @NextSound or= CurTime!
    if CurTime! >= @NextSound
      @NextSound = CurTime! + 0.1
      @EmitSound "physics/concrete/boulder_impact_hard#{math.random 1,4}.wav"
      @EmitSound "weapons/crowbar/crowbar_impact#{math.random 1,2}.wav",
        90,
        math.random(80, 110)
    if (@GetIntegrity! <= 0) and not @Breaking
      @Breaking = true
      with edata = EffectData!
        \SetOrigin pos
        \SetScale 1
        \SetMagnitude 0.5
        \SetRadius 2
        util.Effect "Sparks", edata
      who = dmg\GetAttacker!
      if (who and IsValid(who) and who\IsPlayer! and who\Alive!)
        reward = 24 + math.random(19)
        who\AddMoney reward, "The Toil"
      for i=1,math.random(1,3)
        cls = @LootTable[random 1, #@LootTable]
        loot = ents.Create cls
        with loot
          \Spawn!
          \Activate!
          \SetPos pos
      @Remove!
          
  PhysicsCollide: (data, physobj) =>
    if data.Speed >= 512
      ed = EffectData!
      with ed
        \SetOrigin @GetPos!
        \SetScale 1000
      util.Effect "ThumperDust", ed, true, true
      @EmitSound"physics/concrete/boulder_impact_hard#{math.random 1,4}.wav"
