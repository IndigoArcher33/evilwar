class Submit_Wood extends SOUND
  sound: ["weapons/crowbar/crowbar_impact#{i}.wav" for i=1,2]

class Wood extends ITEM
  @__entity: "wood"
  Spawnable: true

  PrintName: "Wood"
  Model: Model"models/props_junk/garbage_plasticbottle002a.mdl"
  Category: "EvilRP: Precursor"
  Spawnable: true
  Interesting: true

  Sound: "npc/barnacle/neck_snap#{math.random(1, 2)}.wav"

  SubmitSound: "Submit_Wood"

  Submitted: =>
    pos = @GetPos!
    ed = EffectData!
    with ed
      \SetOrigin pos
      \SetScale 1
      \SetMagnitude 1
      \SetRadius 3
    util.Effect "Sparks", ed
    
  OnlyInventoryUse: false
    
  OnUseFinish: (ply) =>
    super ply
    dmg = DamageInfo!
    with dmg
      \SetDamage @BiteDamage
      \SetDamageType DMG_SLASH
      \SetAttacker ply
      \SetInflictor @
      \SetDamagePosition ply\EyePos!
    ply\TakeDamageInfo dmg
    @Remove!
      
class Scrap extends Wood
  Model: Model"models/gibs/wood_gib01a.mdl"

  PrintName: "Scrap Wood"
  Description: "A rough wedge of a tree's flesh."
  UseText: {
    "swallows splinters trying to gnaw on a hunk of wood."
  }

  BiteDamage: 25
    
  Precursor:
    wood: 1
