meta = FindMetaTable"Player"

meta[k] = v for k, v in pairs {
  MakeWanted: (dur, why) =>
    return if CLIENT
    ct = CurTime!
    @SetWantedSince(ct)
    @SetWantedUntil(ct + dur)
    for ply in *player.GetAll!
      Chat.Announce("GENERIC","<c=230,0,0>#{@Name!} is WANTED for #{why}!")
      for term in *ents.FindByClass("terminal*")
        continue unless IsValid(term)
        switch term\GetOS!
          when "public"
            net.Start"evilrp_terminal_flicker"
            net.WriteUInt(16, term\EntIndex!)
            net.Broadcast!
            gterm\Broadcast term, "#{@Name!} IS WANTED FOR #{why\upper!}.", GT_COL_ERR
    @EmitSound("ambient/alarms/manhack_alert_pass1.wav", 0, math.random(60,80)) for i=1,3
  Wanted: =>
    wanted_until = @WantedUntil!
    if wanted_until and wanted_until > 0
      return CurTime! <= wanted_until
  MakeUnwanted: =>
    @SetWantedSince(0)
    @SetWantedUntil(0)
  SetWantedSince: (since) => @SetNWFloat("evilrp_wanted_since", since)
  SetWantedUntil: (dur) => @SetNWFloat("evilrp_wanted_until", dur)    
  WantedSince: => @GetNWFloat("evilrp_wanted_since", 0)
  WantedUntil: => @GetNWFloat("evilrp_wanted_until", 0)
  WantedLength: => @WantedUntil! - @WantedSince!
}


