local matrix
local lights_enabled
local lights_range
local developer  
local sprite

local mat_wave
local mat_spawn

local allow_sound
local default_sound
local extended_whitelist
  
CreateConVar("portals_allow_custom_colors", 1, {FCVAR_ARCHIVE, FCVAR_REPLICATED}, "Whether players should be able to change portal colors.", 0, 1)
CreateConVar("portals_allow_custom_sounds", 1, {FCVAR_ARCHIVE, FCVAR_REPLICATED}, "Whether players should be able to change portal sounds.", 0, 1)
CreateConVar("portals_default_sound", "beams/beamstart5.wav", {FCVAR_ARCHIVE, FCVAR_REPLICATED}, "The default sound that is used for portal effects.")
CreateConVar("portals_extended_whitelist", 1, {FCVAR_ARCHIVE, FCVAR_REPLICATED}, "Whether portals should teleport non-player, non-npc entities.")
  
if CLIENT
  CreateClientConVar("portals_lights_enabled", 1, true, false, "Whether portals should emit light.", 0, 1)
  CreateClientConVar("portals_lights_range", 1024, true, false, "The range at which portals emit light.", 0)
  lights_enabled = GetConVar"portals_lights_enabled"
  lights_range = GetConVar"portals_lights_range"
  developer = GetConVar"developer"
  sprite = Material"sprites/light_glow02_add"
  mat_spawn = CreateMaterial("portal_spawn", "UnlitTwoTexture", {
    ["$basetexture"]: "models/effects/vortshield_color"
    ["$texture2"]: "models/effects/vortshield_base"
    ["$model"]: 1
    ["$nocull"]: 1
    ["$additive"]: 1
    Proxies:
      TextureScroll:
        texturescrollvar: "$texture2transform"
        texturescrollrate: -0.1
        texturescrollangle: 0
  })
  mat_wave = CreateMaterial("portal/wave22", "UnlitTwoTexture", {
    ["$basetexture"]: "models/player/player_chrome1"
    ["$texture2"]: "models/effects/vortshield_base"
    ["$model"]: 1
    ["$nocull"]: 1
    ["$additive"]: 1
    Proxies:
      TextureScroll:
        texturescrollvar: "$texture2transform"
        texturescrollrate: .23
        texturescrollangle: 23
  })
  matrix = Matrix!
  matrix\SetScale Vector(2,2,2)
elseif SERVER
  resource.AddWorkshop"2841352626"
  allow_sound = GetConVar"portals_allow_custom_sounds"
  default_sound = GetConVar"portals_default_sound"
  extended_whitelist = GetConVar"portals_extended_whitelist"
  
class Portal extends ENTITY
  Base: "base_anim"
  Type: "anim"

  RenderGroup: RENDERGROUP_TRANSLUCENT

  Model: Model"models/effects/intro_vortshield.mdl"

  mins: Vector(-25,-25,-25)
  maxs: Vector(25,25,25)

  Initialize: =>
    @SetModel @Model
    @DrawShadow false
    if SERVER
      @PhysicsInitBox(@mins, @maxs)
      @SetMoveType(MOVETYPE_NONE)
      @SetUseType(SIMPLE_USE)
      @SetTrigger true
      @SetNotSolid true
    @SetCollisionGroup COLLISION_GROUP_WORLD

  GetCustomColor: => color_white

  -- CLIENT

  ShouldDoLight: =>
    return false unless lights_enabled\GetBool!
    range = lights_range\GetFloat!^2
    return (not @IsDormant!) and EyePos!\DistToSqr(@GetPos!) < range

  Think: =>
    if CLIENT
      color = @GetCustomColor!
      @SetColor(color) if @GetColor! ~= color
      if @ShouldDoLight!
        light = DynamicLight(@EntIndex!)
        if light
          with light
            .pos = @GetPos!
            .r = color.r
            .g = color.g
            .b = color.b
            .brightness = 2
            .Decay = 1000
            .Size = 128
            .DieTime = CurTime! + 1
      @RemoveAllDecals!

  DrawTranslucent: =>
    if developer\GetBool!
      mins = @mins - Vector(.1,.1,.1)
      maxs = @maxs + Vector(.1,.1,.1)
      color = ColorAlpha(@GetCustomColor!, 50)
      render.SetColorMaterial!
      pos = @GetPos!
      ang = @GetNetworkAngles!
      render.DrawBox(pos, ang, mins, maxs, color, true)
      render.DrawWireframeBox(pos, ang, mins, maxs, color, true)
      render.DrawLine(pos, pos + @GetForward! * 50, @GetCustomColor!, true)
    render.OverrideBlend(true, BLEND_ZERO, BLEND_ONE_MINUS_SRC_COLOR, BLENDFUNC_ADD)
    render.SetMaterial(sprite)
    render.DrawSprite(@GetPos!, 150, 150)
    render.OverrideBlend(false)
    ang = (EyePos! - @GetPos!)\Angle!
    @SetRenderAngles(ang)
    @SetupBones!
    @DrawModel!
    @DrawModel! -- don't know why this is happening twice

  -- SERVER

  TeleportEffect: (ent=@) =>
    snd = default_sound\GetString!
    snd = @GetTeleportSound! if allow_sound\GetBool! and @GetTeleportSound
    return if snd == ""
    ent\EmitSound(snd, 75, 100, 0.5)

  IsValidEntity: (ent) =>
    return ent\GetMoveType! ~= MOVETYPE_NOCLIP if ent\IsPlayer!
    return false if not extended_whitelist\GetBool! and not ent\IsNPC!
    phys = ent\GetPhysicsObject!
    return false if IsValid(phys) and not phys\IsMotionEnabled!
    cls = ent\GetClass!
    return false if cls\find"prop_dynamic"
    return false if cls\find"prop_door"
    return false if cls == "func_physbox" and ent\HasSpawnFlags(SF_PHYSBOX_MOTIONDISABLED)
    return false if cls\find"prop_" and (ent\HasSpawnFlags(SF_PHYSPROP_MOTIONDISABLED)) or ent\HasSpawnFlags(SF_PHYSPROP_PREVENT_PICKUP)
    return false if cls ~= "func_physbox" and cls\find"func_"
    return true
  
class Spawn extends Portal
  RenderGroup: RENDERGROUP_TRANSLUCENT

  PrintName: "Spawnpoint"
  Category: "EvilRP: Portals"

  Spawnable: true
  AdminOnly: true

  Interesting: true

  mins: Vector(-40,-40,-50)
  maxs: Vector(40,40,40)

  SetupDataTables: =>
    @NetworkVar "Int", "Fate"

  -- CLIENT

  OnRemove: =>
    if CLIENT
      @Sound\Stop! if @Sound

  GetCustomColor: => Color(255,80,80)

  HUDRender: =>
    ply = LocalPlayer!
    return false unless ply\Team! == TEAM_GHOST
    fate = @GetFate!
    ct = {}
    ct[] = { text: RPExtraTeams[fate].name }
    ct[] = { text: RPExtraTeams[fate].description, font: "Spleen_Label_Small" }
    ct[] = { text: "Press F4 to choose this purpose in life.", font: "Spleen_Label_Small" }
    return ct

  Think: =>
    return unless CLIENT
    ply = LocalPlayer!
    if ply\Team! ~= TEAM_GHOST
      @Sound\Stop! if @Sound and @Sound\IsPlaying!
      return
    light = DynamicLight(@EntIndex!)
    color = @GetCustomColor!
    @SetColor(color) if @GetColor! ~= color
    if light
      with light
        .pos = @GetPos!
        .r = 255
        .g = 32
        .b = 32
        .brightness = 2
        .Decay = 1000
        .Size = 256
        .DieTime = CurTime! + 1
    unless @Sound
      @Sound = CreateSound(@, "ambient/levels/citadel/citadel_drone_loop2.wav")
      @Sound\ChangePitch(0.2)
      @Sound\SetSoundLevel(75)
    @Sound\Play! unless @Sound\IsPlaying!
    @EnableMatrix("RenderMultiply", matrix)

  GetPortalMat: => mat_spawn

  DrawTranslucent: =>
    ang = (EyePos! - @GetPos!)\Angle!
    render.MaterialOverride(@GetPortalMat!)
    @SetRenderAngles(ang)
    @SetupBones!
    @DrawModel! if LocalPlayer!\Team! == TEAM_GHOST
    render.MaterialOverride!

  -- SERVER

  IsValidEntity: (ent) => true if ent\IsPlayer! and ent\Team! == TEAM_GHOST

  Use: (ply) =>
    return unless @IsValidEntity(ply)
    ply\ForcePlayerDrop!
    if ply\IsPlayer!
      @SpawnPlayer(ply)
    else
      ply\Remove!

  SpawnPlayer: (ply) =>
    return unless ply\IsPlayer!
    fate = @GetFate!
    cost = RPExtraTeams[fate].cost or 0
    cooldown = RPExtraTeams[fate].cooldown or 0
    if cooldown > 0 and ply.cooldowns and ply.cooldowns[fate]
      if ply.cooldowns[fate] > CurTime!
        ply\Notify"<c=200,0,0>TOO QUICK, LET IT REST."
        net.Start"evilrp_jumpscare"
        net.Send ply
        return
    plypop = player.GetCount!
    threshold = RPExtraTeams[fate].pop_threshold or 0
    if plypop <= threshold
      ply\Notify"<c=200,0,0>THERE ARE NOT ENOUGH SOULS TO TORTURE"
      net.Start"evilrp_jumpscare"
      net.Send ply
      return
    if ply\GetStemCells! >= cost
      @TeleportEffect!
      ply\Notify"<c=200,0,0>DEATHS TODAY: #{GAMEMODE\Deaths!}"
      ply\AddStemCells(-cost) if cost > 0
      ply\ScreenFade(SCREENFADE.IN, Color(255, 0, 0), 2.5, 0)
      ply\changeTeam(fate)
      snd = table.Random(RPExtraTeams[fate].become_sounds)
      ply\EmitSound(snd)
      ply\EmitSound("npc/stalker/go_alert2.wav", 140, 40, 0.2)
      ply\Reflect!
      net.Start"evilrp_receive_stocks"
      net.WriteTable(GAMEMODE.Stocks)
      net.Send(ply)
    else
      net.Start"evilrp_jumpscare"
      net.Send ply
      ply\Notify"<c=200,0,0>YOU HAVE #{ply\GetStemCells!} STEM CELLS."
      ply\Notify"<c=200,0,0>YOU NEED #{cost} STEM CELLS TO HAVE THIS PURPOSE IN LIFE."

class WavePrepared extends SOUND
  sound: "npc/combine_gunship/ping_patrol.wav"
  pitch: {80, 90}
  volume: 0.9
      
class Wave extends Spawn
  PrintName: "Wavepoint"

  spawn_delay: 30
    
  SetupDataTables: =>
    super!
    @NetworkVar "Bool", "Active"
    @NetworkVar "Int", "SpawnTime"

  GetCustomColor: =>
    if @GetActive!
      return HSVToColor (CurTime! * 128) % 360, 1, 1
    else
      Color(0,0,255)

  GetPortalMat: => mat_wave
        
  HUDRender: =>
    ply = LocalPlayer!
    return false unless ply\Team! == TEAM_GHOST
    fate = @GetFate!
    ct = {}
    ct[] = { text: RPExtraTeams[fate].name }
    ct[] = { text: RPExtraTeams[fate].description, font: "Spleen_Label_Small" }
    ct[] = { text: " " }
    if @GetActive!
      ct[] = { text: "A wave is gathering in T-#{string.NiceTime(@GetSpawnTime! - CurTime!)}.", font: "Spleen_Label_Small" }
      if ply\GetPos!\DistToSqr(@GetPos!) < 256^2
        ct[] = { text: "Stay close to participate.", font: "Spleen_Label_Small" }
      else
        ct[] = { text: "Come closer.", font: "Spleen_Label_Small" }
    else
      ct[] = { text: "A wave is not gathering.", font: "Spleen_Label_Small" }
      ct[] = { text: "You can change that, if you're ready.", font: "Spleen_Label_Small" }
    return ct

  Use: (ply) =>
    return unless @IsValidEntity(ply)
    ply\ForcePlayerDrop!
    return if @GetActive! -- already active, doesn't need to be used again
    @EmitSound"WavePrepared"
    @SetActive(true)
    @SetSpawnTime(CurTime! + @spawn_delay)

  GetNearbyGhosts: =>
    ghosts = {}
    ghosts[] = ply for ply in *player.GetAll! when (ply\Team! == TEAM_GHOST and ply\GetPos!\DistToSqr(@GetPos!) <= 256^2)
    return ghosts

  SpawnWave: =>
    ghosts = @GetNearbyGhosts!
    unless #ghosts > 0
      -- no players passed verification
      return @Reset!
    @SpawnPlayer(g) for g in *ghosts
    @Remove!

  Reset: =>
    @SetActive(false)
    @SetSpawnTime(0)

  Think: =>
    super!
    return unless SERVER
    if @GetActive!
      ct = CurTime!
      @next_ghost_check = ct unless @next_ghost_check
      if ct >= @next_ghost_check
        @next_ghost_check = ct + 3
        nearby = @GetNearbyGhosts!
        unless #nearby > 0
          return @SetActive(false)
      if ct >= @GetSpawnTime!
        return @SpawnWave!
