-- TODO: port Log from CC2
global Chat = {} unless Chat
Chat.list or= {}
Chat.commands or= {}
Chat.aliases or= {}
Chat.console_commands or= {}

meta = FindMetaTable"Player"
emeta = FindMetaTable"Entity"

meta.Typing = => @GetNWString("evilrp_typing", nil)
meta.SetTyping = (str) => @SetNWString("evilrp_typing", str)

Chat.Process = (ply, str) ->
  for alias, command in pairs(Chat.aliases)
    if string.Left(str, #alias) == alias
      str = string.format("/%s %s", command, string.sub(str, #alias + 1))
      break
  lang, command, args = string.match(str, "^[/!](%w+)%.(%w+)%s*(.-)%s*$")
  if true or not Language.Lookup[lang]
    -- LANGUAGE STUFF GOES HERE
    -- lang = ply\ActiveLanguage!
    lang = nil
    command, args = string.match(str, "^[/!](%w+)%s*(.-)%s*$")
    unless command
      command, args = "say", string.Trim(str)
  else
    lang = string.lower(lang)
  return lang, string.lower(command), args

Chat.GetTargets = (pos, range, range_muffled, with_entities) ->
  range_max = math.max(range, range_muffled)
  targets = {}
  for _, ent in pairs(ents.FindInSphere(pos, range_max))
    continue if not ent\IsPlayer! and (not with_entities or not ent.OnHear)
    dist = ent\GetPos!\DistToSqr(pos)
    if ent\CanHear(pos)
      targets[] = ent if dist < range_max^2
    elseif dist <= range_muffled
      targets[] = ent if dist <= range_muffled^2
  return targets

Chat.Parse = (ply, str) ->
  lang, cmd, args = Chat.Process(ply, str)
  if CLIENT
    if Chat.console_commands[cmd]
      console.Parse lp, Chat.console_commands[cmd], args
    else
      netstream.Send "ParseChat", str
  else
    return if Chat.ThoughtPolice(ply, str)
    command = Chat.commands[cmd]
    if not command
      ply\SendChat "ERROR", "Unknown command: #{cmd}"
      return
    command\Handle ply, lang, cmd, args

Chat.Autopretty = (ply, text) ->
  for k, v in pairs Chat.StupidMistakes
    st_start, st_end = string.find(string.lower(text), " #{k} ")
    if st_start
      text = "#{string.sub(text, 1, st_start - 1)} #{v} #{string.sub text, st_end + 1}"
    st_start_comma, st_end_comma = string.find(text, " #{k},")
    if st_start_comma
      text = "#{string.sub(text, 1, st_end_comma - 1)} #{v},#{string.sub(text, st_end_comma + 1)}"
    st_beginning = string.sub(text, 1, string.len(k) + 1)
    if st_beginning == ("#{k} ") or string.lower(text) == k
      text = "#{v}#{string.sub(text, string.len(k) + 1)}"
    st_ending = string.sub(text, string.len(text) - string.len(" #{k}") + 1)
    if st_ending == (" #{k}")
      text = string.sub(text, 1, string.len(text) - string.len(" #{k}")) .. " #{v}"
  fix_illiterate = string.sub(text, 1, 1)
  text = string.upper(fix_illiterate) .. string.sub(text, 2, string.len(text))
  fix_illiterate_2 = string.sub(text, -1)
  switch fix_illiterate_2
    when ".", "!", "?", ":", ";", ","
      -- do nothing
    else
      -- add a period, at least
      text ..= "."
  return text

Chat.ThoughtPolice = (ply, text) ->
  for bad in *Chat.BadWords
    if string.find(text\lower!, bad)
      net.Start"evilrp_jumpscare"
      net.Send ply
      ply\SendChat "ERROR", "'#{bad}'"
      CRIMES.thought\CommittedBy(ply)
      return true
  return false

if CLIENT
  Chat.Create = ->
    panel = GUI.Get"Chat"
    if IsValid panel
      buffer = panel\ExportBuffer!
      GUI.Open"Chat"\ImportBuffer buffer
    else
      GUI.Open"Chat"

  Chat.Bind = (bind, down) ->
    if down and bind\find"messagemode"
      Chat.Show!
      return true

  Chat.Show = -> GUI.Get"Chat"\Show!

  Chat.Hide = ->
    GUI.Get"Chat"\Hide!
    if lp\Typing! ~= nil
      lp\SetTyping nil
      netstream.Send "Typing", nil

  Chat.Receive = (name, data) ->
    data = {text: data} if isstring data
    command = Chat.list[name]
    message, console_message = command\OnReceive data
    if isstring message
      -- put sounds for certain commands here
      GUI.Get"Chat"\AddMessage message, console_message, command.tabs

  netstream.Hook "SendChat", (payload) ->
    Chat.Receive(payload.__type, payload)

if SERVER
  netstream.Hook "ParseChat", Chat.Parse

  netstream.Hook "Typing", (ply, cmd) ->
    if cmd and Chat.commands[cmd]
      ply\SetTyping(cmd)
    else
      ply\SetTyping nil

  Chat.Send = (name, data, targets) ->
    data = {text: data} if isstring data
    data.__type = name
    targets = {targets} unless istable(targets)
    netstream.Send targets, "SendChat", data

  GM.PlayerSay = (ply, text, t) =>
    Chat.Parse ply, text
    return ""

meta.SendChat = (name, data) =>
  if CLIENT
    assert @ == lp, "Attempt to SendChat to a non-local player"
    Chat.Receive name, data
  else
    Chat.Send name, data, @

