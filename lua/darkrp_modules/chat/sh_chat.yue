  OnReceive: (data) => "<font=#{@font}><c=#{@color}>ERROR: #{data.text}", "<c=#{@color_console}>ERROR: #{data.text}"

global class CHAT_CMD_IC extends CHAT_CMD
  tabs: TAB_IC
  log_category: "ic"

  Handle: (ply, lang, cmd, text) =>
    unless ply\Alive!
      ply\SendChat "ERROR", "You're DEAD."
      return
    super ply, lang, cmd, text

class Action extends CHAT_CMD_IC
  name: "Action"
  desc: "Do something."
  typing: "Performing..."

  commands: {"me", "em"}
  aliases: {":", "*"}

  range: 400
  range_muffled: 0

  font: "Spleen_Chat"

if CLIENT
  Action.OnReceive = (data) =>
    text = data.text
    text = " #{text}" if not string.match(text, "^[,.']")
    return "<font=#{@font}><c=#{data.color}>** #{data.name}#{text}"

if SERVER
  Action.Parse = (ply, lang, cmd, text) =>
    return { name: ply\Name!, color: ply\getJobTable!.color, :text }

class Say extends CHAT_CMD_IC
  name: "Say"
  desc: "Speak out to those around you."
  typing: "Lying..."
  tense: "said"

  commands: {"say"}

  use_language: true
  hearable: true

  range: 400
  range_muffled: 150

  font: "Spleen_Chat"

  color: Color(91, 166, 221)
  color_lang: Color(255, 167, 73)

  Process: (ply, text) => Chat.Autopretty ply, text

if CLIENT
  Say.OnReceive = (data) => "<font=#{@font}><c=#{data.name_color}>#{data.name} <c=#{Color(255,255,255)}>#{@tense}, <c=#{@color}>\"#{data.text}\""
  -- UNFINISHED LANGUAGE VERSION
  -- Say.OnReceive = (data) =>

  --   if data.form -- we don't understand them
  --     return "<font=#{@font}><c=#{@color_lang}>#{data.name} #{data.form}."
  --   else -- we do understand them
  --     if data.lang == lp\NativeLanguage!
  --       return "<font=#{@font}><c=#{@color}>#{data.name} #{@tense}, \"#{data.text}\""
  --     else
  --       return "<font=#{@font}><c=#{@color_lang}>#{data.name} said in #{Language.Get(data.lang).name}, \"#{data.text}\""
if SERVER
  Say.Parse = (ply, lang, cmd, text) =>
    targets = @GetTargets ply
    valid = {}
    invalid = {}
    for target in *targets
      -- if target == ply or target\CanUnderstandLanguage(lang)
      if target == ply or true
        valid[] = target
      else
        invalid[] = target
    -- TODO: LOG CHAT HERE
    -- no reason to check for an empty table since we're always sending the valid version to ourselves
    name_color = ply\getJobTable!.color
    text = @Process ply, text
    ply\PlaySpeechSound text, SNDLVL_65DB unless @silent
    Chat.Send @name, {
      name: ply\Name!
      :name_color
      :lang
      :text
    }, valid
    -- TODO: SEND LANGUAGE TEXT TO INVALIDS

class Yell extends Say
  name: "Yell"
  desc: "Yell something at the top of your lungs."
  typing: "Yelling..."
  tense: "shouted"

  commands: {"yell", "y"}

  range: 800
  range_muffled: 400

  color: Color(255, 50, 50)
  color_lang: Color(255, 167, 73)

  Process: (ply, text) =>
    text = super ply, text
    text = string.upper text
    punc = string.sub(text, string.len(text))
    switch punc
      when "."
        text = "#{string.sub(text, 1, -2)}!"
      when "?"
        text ..= "!"
      else
        text ..= "!"
    return "<wiggle=2>#{text}</wiggle>"

