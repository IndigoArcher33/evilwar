class Radio extends Say
  name: "Radio"
  desc: "Call your squad."
  typing: "Chattering..."
  tense: "called"

  silent: true

  font: "Spleen_Chat_Small"

  commands: {"radio", "r"}

  tabs: TAB_RADIO
  log_category: "radio"

  range: 1500
  range_muffled: 0

  color: Color(151, 151, 151)
  color_lang: Color(255, 167, 73)

if SERVER
  Radio.Parse = (ply, lang, cmd, text) =>
    my_category = ply\getJobTable!.category
    valid = {}
    for _, target in pairs(player.GetAll!)
      continue unless target\getJobTable!.category == my_category
      valid[] = target
    -- TODO: LOG CHAT HERE
    name_color = ply\getJobTable!.color
    text = @Process ply, text
    Chat.Send @name, {
      name: ply\Name!
      :name_color
      :lang
      :text
    }, valid

class XOMBOKOM extends SOUND
  level: SNDLVL_NONE
  sound: ["kidneydagger/broadcast#{i}.wav" for i=1,7]

class DEUS extends SOUND
  level: SNDLVL_NONE
  sound: ["changes#{i}.ogg" for i=1,2]

class Broadcast extends CHAT_CMD_IC
  name: "Broadcast"
  desc: "Make them all listen."
  typing: "Decreeing..."

  commands: {"broadcast", "ad"}

  color: Color(200, 0, 0)

  font: "Spleen_Chat"

  Process: (ply, text) => Chat.Autopretty ply, text\upper!

  Handle: (ply, lang, cmd, text) =>
    unless ply\Team! == TEAM_EMPEROR
      ply\Notify"<c=200,0,0>This power is NOT FOR YOU."
      return
    super ply, lang, cmd, text

class Meistercast extends CHAT_CMD_IC
  name: "Meistercast"
  desc: "Make them all listen."
  typing: "Decreeing..."

  commands: {"broadcast", "ad"}

  color: Color(210, 100, 0)

  font: "Spleen_Chat"

  Process: (ply, text) => Chat.Autopretty ply, text\upper!

  Handle: (ply, lang, cmd, text) =>
    unless ply\Team! == TEAM_DEALER
      ply\Notify"<c=200,0,0>This power is NOT FOR YOU."
      return
    super ply, lang, cmd, text

class Godcast extends CHAT_CMD_IC
  name: "Godcast"
  desc: "Make them all listen."
  typing: "Decreeing..."

  commands: {"godcast", "god"}

  color: Color(0, 0, 0)

  font: "Spleen_Chat"

  Process: (ply, text) => Chat.Autopretty ply, text\upper!

  Handle: (ply, lang, cmd, text) =>
    unless ply\IsSuperAdmin!
      ply\Notify"<c=200,0,0>This power is NOT FOR YOU."
      return
    super ply, lang, cmd, text

if CLIENT
  Broadcast.OnReceive = (data) => "<font=#{@font}><c=#{@color}>[XOMBOKOM] <wiggle>#{data.text}"
  Godcast.OnReceive = (data) => "<font=#{@font}><c=#{@color}>[ORACLEKOM] <wiggle>#{data.text}"
  Meistercast.OnReceive = (data) => "<font=#{@font}><c=#{@color}>[MEISTERKOM] <wiggle>#{data.text}"
if SERVER
  Broadcast.Parse = (ply, lang, cmd, text) =>
    text = @Process ply, text
    ply\EmitSound"XOMBOKOM"
    return { :text }

  Meistercast.Parse = (ply, lang, cmd, text) =>
    text = @Process ply, text
    ply\EmitSound"kidneydagger/vote.ogg"
    return { :text }
  
  Godcast.Parse = (ply, lang, cmd, text) =>
    text = @Process ply, text
    ply\EmitSound"DEUS"
    ply\AddDespair 5
    net.Start"evilrp_frighten"
    net.Send ply
    ply\Notify"<c=200,0,0> #{text}."
    return { :text }
  -- OOC.WriteLog = (data, ply) =>

class OOC extends CHAT_CMD
  name: "OOC"
  desc: "Global out-of-character chat."
  typing: "Typing..."

  commands: {"ooc"}
  aliases: {"//"}

  tabs: TAB_OOC
  log_category: "ooc"

  color: Color(200, 0, 0)

  font: "Spleen_Chat_Small"

if CLIENT
  OOC.OnReceive = (data) =>
    local prefix
    if data.rainbow_name
      prefix = "<font=#{@font}><c=#{@color}>[OOC]</c> <rgb=1,13,30>#{data.name}</rgb>"
    else
      prefix = "<font=#{@font}><c=#{@color}>[OOC]</c> <c=#{data.color}>#{data.name}</c>"
    return "#{prefix}: #{data.text}"
if SERVER
  -- TODO: OOC muting for specific players
  -- TODO: OOC delay
  OOC.Parse = (ply, lang, cmd, text) =>
    sid = ply\SteamID!
    r = util.SharedRandom(sid, 0, 255, 1)
    g = util.SharedRandom(sid, 0, 255, 2)
    b = util.SharedRandom(sid, 0, 255, 3)
    color = Color(r,g,b)
    rainbow_name = ply\HasDonation"rainbow" and (ply\GetInfoNum("lfr_rainbow_username", 1) == 1)
    return { name: ply\SteamName!, :color, :text, :rainbow_name }
  -- OOC.WriteLog = (data, ply) =>

