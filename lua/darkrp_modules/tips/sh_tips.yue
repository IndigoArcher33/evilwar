
if CLIENT
  CreateClientConVar("lfr_hints", 1, true, true, "Toggle whether hints display each time you become a ghost.")

meta = FindMetaTable"Player"

meta.TakeAHint = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=128,128,128> You are a ghost, an unfortunate soul in this forsaken world. You can teleport to certain areas with the R key, areas that you can find a body you can possess.") -- Yes, i know how bloated this will be and look but it works and i dont give a single fuck - cinnamon

meta.TakeAHintStalker = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=0,200,200> You are a stalker, a unpatriotic wastelander. Maybe, you could possibly barter with the EMPEROR with whatever you can find out with the wastes, and in the mines. Unlike everyone else, you are talented. Talented at not caring about what trash you'll dig through today.")

meta.TakeAHintBonehead = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=255,255,255> ARRRRGHH, MUST KILL THEM ALL AND TAKE THEIR SKIN!!!")

meta.TakeAHintPrivate = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=0,200,0> You are a patriotic Lymphoman resident conscripted to serve as both a laborer and combatant. You are mainly responsible about the productivity and labor of this glorious city and can operate factories unlike anyone else.")

meta.TakeAHintConscript = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=0,0,200> You have been conscripted by the emperor himself to serve as a policing unit in Lymphoma. You're responsible for keeping order in the city and risking your life for the Emperor. This role holds responsibility.<c=0,0,0> You must not purposely cause the deaths of your comrades. If you cannot take this responsibility, kill yourself.")

meta.TakeAHintSanitar = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=0,0,200> You are apart of the dragoons, the EMPEROR'S finest and superb soldiers. The Privates, Conscripts, and Sanitaters are your subordinates, Whilst the EMPEROR and the Quartermaster are your superiors. <c=0,0,0>Keep order within the city, but If you cannot take this responsibility, kill yourself.")

meta.TakeAHintDealer = =>
  @SendChat("GENERIC", "<f=Spleen_Chat><c=255,255,0> You are the Quartermaster. Thanks to your kapitalist mindset, your able to get better deals from the autodealers. You can use /meister to let everyone hear your voice.<c=0,0,0> But, if you cannot take the responsibility of being a quartermaster, kill yourself.")

meta.TakeAHintEmperor = =>
    @SendChat("GENERIC", "<f=Spleen_Chat><c=200,0,0> You are the EMPEROR, the wise leader of the Lymphomians. You must keep order within your city, and keep your men in line. Perhaps think about conscripting a few privates to keep the city safe.")


hook.Add "PlayerSpawn", "evilrp_hints", (ply) ->
  return unless ply\GetInfoNum("lfr_hints", 1) == 1
  timer.Simple(3, ->
    return unless ply and IsValid(ply)
    return unless ply\Alive!
    unless ply.got_first_hint
      ply.got_first_hint = true
      ply\SendChat("GENERIC", "<f=Spleen_Chat><c=128,128,128> You are a ghost, an unfortunate soul in this forsaken world. You can teleport to certain areas with the R key, areas that you can find a body you can possess.")
      ply\SendChat("GENERIC", "<f=Spleen_Chat_Small><c=0,100,100>[ <c=0,200,200>You can press F1 to receive info on your current fate in life, at any time. <c=0,100,100>]"))

hook.Add "ShowHelp", "evilrp_hints", (ply) ->
  return unless SERVER
  return unless ply\Alive!
  if ply\Team! == TEAM_GHOST
    ply\TakeAHint!
    return
  if ply\Team! == TEAM_STALKER
    ply\TakeAHintStalker!
    return
  if ply\Team! == TEAM_BONEHEAD
    ply\TakeAHintBonehead!
    return
  if ply\Team! == TEAM_PRIVATE
    ply\TakeAHintPrivate!
    return
  if ply\Team! == TEAM_CONSCRIPT
    ply\TakeAHintConscript!
    return
  if ply\Team! == TEAM_SANITAR
    ply\TakeAHintSanitar!
    return
  if ply\Team! == TEAM_DEALER
    ply\TakeAHintDealer!
    return
  if ply\Team! == TEAM_KORPSMAN
    ply\TakeAHintKorpsman!
    return
  if ply\Team! == TEAM_EMPEROR
    ply\TakeAHintEmperor!
    return
