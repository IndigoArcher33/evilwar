hints =
  * "Despair distorts your vision and the stability of text."
  * "As a ghost, pressing R will teleport you somewhere else, such as if you get stuck."
  * "As a ghost, you can fly by jumping while holding SHIFT."
  * "It's only a crime if the authorities see it."
  * "Right click on a fallen body with empty hands in order to pick it up."
  * "Your needs are not suggestions; maxing out any of them will kill you."
  * "Under some circumstances, death may incur loss of stem cells."
  * "You can be horrible, but it can mean even more to be friendly."
  * "Death will not lower your needs in the majority of cases."
  * "Pressing F4 or opening the context menu (on the C key by default) can bring up multiple options for interacting with some objects."
  * "It's better to be interesting than perfect."
  * "It's better to be pissed off than pissed on."
  * "There's no use crying over spilled blood."
  * "Press F3 to access your inventory; inside, left clicking on an item will use it while right clicking on one will drop it."
  * "You can estimate your remaining ammo for an equipped weapon by holding the USE key and pressing your RELOAD key."
  * "When the world shakes and howls, that means the game's code was altered -- something changed."
  * "Stem cells are kept between the world's reincarnations, unlike your bones and your items. They're nice to have and painful to lose."
  * "You don't have to be the one to push the buttons; stocking the facilities is arguably more helpful."
  * "Admin abuse can, will, and does happen."
  * "Press B to whip it out."
  * "Voice communication is permanently disabled."
  * "Does this game offend your senses? It has a variety of options you can customize. Try opening the developer's console and look for console variables that begin with <c=0,200,0>lfr_<c=0,200,200>."

if CLIENT
  CreateClientConVar("lfr_hints", 1, true, true, "Toggle whether hints display each time you become a ghost.")

meta = FindMetaTable"Player"

meta.TakeAHint = =>
  @SendChat("GENERIC", "<f=Spleen_Chat_Small><c=0,200,200>#{hints[math.random(#hints)]}")

hook.Add "PlayerSpawn", "evilrp_hints", (ply) ->
  return unless ply\GetInfoNum("lfr_hints", 1) == 1
  timer.Simple(3, ->
    return unless ply and IsValid(ply)
    return unless ply\Alive!
    return unless ply\Team! == TEAM_GHOST
    ply\TakeAHint!
    unless ply.got_first_hint
      ply.got_first_hint = true
      ply\SendChat("GENERIC", "<f=Spleen_Chat_Small><c=0,100,100>[ <c=0,200,200>You can change whether you receive these hints with console variable <c=0,200,0>lfr_hints<c=0,200,200>. <c=0,100,100>]")
      ply\SendChat("GENERIC", "<f=Spleen_Chat_Small><c=0,100,100>[ <c=0,200,200>While a ghost, you can press F1 to take another hint. <c=0,100,100>]"))

hook.Add "ShowHelp", "evilrp_hints", (ply) ->
  return unless SERVER
  return unless ply\Team! == TEAM_GHOST
  return unless ply\Alive!
  ply\TakeAHint!
