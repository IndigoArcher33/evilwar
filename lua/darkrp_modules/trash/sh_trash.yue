class BottleSmash extends SOUND
  sound: "placenta/weapons/bottle_break.wav"
     
class Bottle extends Trash
  PrintName: "Empty Bottle"

  Model: Model"models/props_junk/garbage_glassbottle003a.mdl"

  Description: "Where's the booze?"

  SubmitSound: "Trash_Glass"

  Refinement:
    time: 2
    rust: 1

  ImpactThreshold: 256
  
  Initialize: =>
    super!
    @PrecacheGibs! if SERVER

  OnTakeDamage: (dmg) =>
    super dmg
    types = DMG_CLUB + DMG_SLASH + DMG_BULLET + DMG_CRUSH
    attacker = dmg\GetAttacker!
    @Shatter(dmg\GetDamageForce!, attacker) if dmg\GetDamage! > 10 and dmg\IsDamageType(types)
    if attacker and IsValid(attacker) and attacker\IsPlayer!
      if attacker\HasOddity(ODDITY_DELINQUENCY)
        attacker\AddDespair(-math.random(2,4))

  PhysicsCollide: (data) =>
    super data
    return if CLIENT
    if data.Speed > @ImpactThreshold
      if data.HitEntity and IsValid(data.HitEntity)
        attacker = @GetNWEntity"evilrp_submitter"
        with dmg = DamageInfo!
          \SetDamage 10
          \SetAttacker attacker if IsValid(attacker)
          \SetInflictor @
          \SetDamageType DMG_SLASH
          \SetDamagePosition data.HitPos
          data.HitEntity\TakeDamageInfo dmg
      force = data.OurNewVelocity
      @Shatter force

  Shatter: (force, attacker=@GetNWEntity"evilrp_submitter") =>
    return if @broken
    @broken = true
    pos = @GetPos!
    for ply in *player.GetAll!
      continue unless ply\HasOddity(ODDITY_DELINQUENCY)
      if ply\CanSee(@) and ply\LookingInDirection(pos)
        ply\AddDespair(-math.random(2,4))
    with ed = EffectData!
      \SetStart pos
      \SetOrigin pos
      \SetScale 8
      util.Effect "GlassImpact", ed, true, true
    @EmitSound"BottleSmash"
    @GibBreakServer force if force
    @Remove!
      
class FearBeer extends Bottle
  Model: Model"models/props_junk/garbage_glassbottle001a.mdl"

class Plastic extends Trash
  PrintName: "Macroplastics"

