class Trash_Cardboard extends SOUND
  sound: ["physics/cardboard/cardboard_box_break#{i}.wav" for i=1,3]

class Trash_Metal extends SOUND
  sound: ["physics/metal/metal_box_break#{i}.wav" for i=1,2]

class Trash_Glass extends SOUND
  sound: ["physics/glass/glass_largesheet_break#{i}.wav" for i=2,3]

class Trash_Plastic extends SOUND
  sound: ["physics/plastic/plastic_barrel_break#{i}.wav" for i=1,2]
    
class Trash extends ENTITY
  Base: "base_anim"
  Type: "anim"

  Spawnable: true
  AdminSpawnable: true

  Category: "EvilRP: Trash"
    
  Interesting: true
    
  PrintName: "Trash"
    
  Description: "It no longer serves its intended purpose.\nIts corpse could be recycled at a Refinery."

  OnTakeDamage: (dmg) =>
    @TakePhysicsDamage dmg

  PhysicsCollide: (data, physobj) =>
    prop1 = util.GetSurfaceData(data.OurSurfaceProps)
    prop2 = util.GetSurfaceData(data.TheirSurfaceProps)
    if data.Speed >= 75 and ((@LastImpact or 0) + 0.1 < CurTime!)
      @LastImpact = CurTime!
      snd = switch type(@ImpactSound)
        when "table"
          @ImpactSound.hard
        when "string"
          @ImpactSound
        when "nil"
          prop1.impactHardSound
      @EmitSound snd
      -- @SetCollisionGroup COLLISION_GROUP_WEAPON if @SizeClass <= SIZE_SMALL
    elseif data.Speed >= 25 and ((@LastImpact or 0) + 0.1 < CurTime!)
      @LastImpact = CurTime!
      snd = switch type(@ImpactSound)
        when "table"
          @ImpactSound.soft
        when "string"
          @ImpactSound
        when "nil"
          prop1.impactSoftSound
      @EmitSound snd
      -- @SetCollisionGroup COLLISION_GROUP_WEAPON if @SizeClass <= SIZE_SMALL
  SubmitSound: "Trash_Cardboard"

  Initialize: =>
    @SetModel @Model
    if SERVER
      @PhysicsInit SOLID_VPHYSICS
      @SetMoveType MOVETYPE_VPHYSICS
      @SetSolid SOLID_VPHYSICS
      @SetUseType SIMPLE_USE
      @PhysWake!

  Use: (ply) =>
    if @IsPlayerHolding! and ply == @ply
      ply\DropObject!
    else
      @ply = ply
      ply\PickupObject(@)
      @SetNWEntity("evilrp_submitter", ply)
  
  PMRender: (item) ->
    ct = {}
    wt = scripted_ents.Get item.class
    ct[] = wt.PrintName
    if wt.Description
      ct[] = ""
      ct[] = { text: wt.Description, font: "Spleen_Label_Small" }
    return ct

  HUDRender: =>
    ct = {}
    ct[] = @PrintName
    if @Description
      ct[] = ""
      ct[] = { text: @Description, font: "Spleen_Label_Small" }
    return ct

  Interactions: (ply) =>
    actions = {}
    if (@Pocketable ~= false)
      actions[] = { desc: "Pocket", func: (-> netstream.Send("PocketItem", @) ) }
    return actions


class Fuel extends Trash
  PrintName: "Empty Jerrycan"
    
  Model: Model"models/props_junk/metalgascan.mdl"
  SubmitSound: "Trash_Metal"
  Refinement:
    result: "metal/scrap"
    time: 5
    rust: 3

