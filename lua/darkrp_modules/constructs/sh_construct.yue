class Equip_Weapon extends SOUND
  sound: ["dysphoria/weapons/wield_gun#{i}.ogg" for i=1,3]

noise = Material"effects/tvscreen_noise001a"
  

entity_cost = {
  {
    cls: "entity_longuse/trap/wiretrap/shotgunwire"
    precursors:
      metal: 3
      wood: 3
  }
  {
    cls: "entity_longuse/trap/wiretrap"
    precursors:
      metal: 2
  }
  {
    cls: "entity_longuse/trap/ied"
    precursors:
      metal: 1
      wood: 3
  }
  {
    cls: "npc_manned_emplacement"
    precursors:
      metal: 10
      wood: 5
  }
}

getCostFromCls = (cls, precursor) ->
  return 0 unless cls and cls ~= ""
  for ent in *entity_cost
    if ent.cls == cls
      return ent.precursors[precursor] or 0
  return 0


class Construct extends ITEM
  @__entity: "evilrp/spawned/construct"
  PrintName: "Construct"
  Spawnable: true
  Model: Model"models/props_c17/consolebox05a.mdl"
  AdminSpawnable: true
  Interesting: true

  Precursors: 
    * name: "biomass"
    * name: "fluid"
    * name: "metal"
    * name: "wood"

  ImpactSound:
    soft: "weapon.ImpactSoft"
    hard: "weapon.ImpactHard"

  BasePay: 5

  SetupDataTables: =>
    super!
    @NetworkVar("String", "EntityClass")
    @NetworkVar("Bool", "Started")

    for p in *@Precursors
      name = "#{p.name\sub(1, 1)\upper!}#{p.name\sub(2, -1)}"
      @NetworkVar("Int", "Precursor#{name}")
    @NetworkVar("Entity", "Worker")

  AddPrecursor: (pre, amt) =>
    cls = @GetEntityClass!
    return false unless cls and cls ~= ""
    cost = getCostFromCls(cls, pre)
    return false if cost <= 0
    name = "#{pre\sub(1, 1)\upper!}#{pre\sub(2, -1)}"
    -- look, I'm going to be real, I fucking hate this with every fiber of my being but I genuinely don't think
    -- there's a better way of doing this without a fuckton of boilerplate code for every single precursor. Do I hate getting a function from a string?
    -- A lot, I really do, but it's 4AM and I'm tired, I saw amy do it in sh_machine and I'm not sure how bad it really is   ~Vel

    current = @["GetPrecursor#{name}"](@)
    return false if current >= cost
    @["SetPrecursor#{name}"](@, math.min(current + amt, cost)) -- I don't fully get why but you need to pass the @ (self) as the first parameter if you ever do this
    @SetStarted true if not @GetStarted!
    return true

  Touch: (what) =>
    if SERVER
      return unless what.Precursor
      return if what.Processed

      local pre, amt
      for p in *@Precursors
        for k, v in pairs what.Precursor
          if p.name == k
            pre = k
            amt = v
            amt = amt(@) if isfunction(amt)
            break
      return unless (pre and amt)

      return unless @AddPrecursor pre, amt

      what.Processed = true
      what\EmitSound what.SubmitSound if what.SubmitSound
      what.Submitted what if what.Submitted

      submitter = what\GetNWEntity "evilrp_submitter", NULL
      reward = math.random(10, 15) * amt
      rate = GAMEMODE.taxes.labor / 100
      taxed = math.floor(reward * rate)
      reward -= taxed
      GAMEMODE.taxes_stored.labor += taxed if taxed > 0
      reward = math.ceil(reward)

      if submitter and IsValid(submitter) and submitter\IsPlayer! and submitter\Alive!
        submitter\AddMoney reward, "The Operation"
      else
        GAMEMODE.taxes_stored.labor += reward if reward > 0

      what\Remove!

      if submitter and IsValid(submitter) and submitter\IsPlayer! and submitter\Team! == TEAM_PRIVATE
        submitter.precursor_supplied or= 0
        submitter.precursor_supplied += amt
        if submitter.precursor_supplied_difference and (submitter.precursor_supplied % 50) < submitter.precursor_supplied_difference
          submitter\Notify"<c=0,200,0>Your work ethic makes Liver Failure proud."
          submitter\AddStemCells(1)
        submitter.precursor_supplied_difference = submitter.precursor_supplied % 50

  HUDRender: =>
    ct = {}
    cls = @GetEntityClass!
    ent = scripted_ents.Get(cls) if cls and cls ~= ""
    printName = ""
    printName = ent.PrintName if ent and ent.PrintName
    printName = "MG Emplacement" if cls == "npc_manned_emplacement" -- REALLY cheap fix, I need to rewrite the emplacement entity in yue
    ct[] = "Constructing... #{printName}"
    ct[] = ""
    ct[] = { text: "Supply the necessary materials.", font: "Spleen_Label_Small" }
    return ct

  Draw: =>
    @DrawModel!
    @Render3D2D!

  Render3D2D: =>
    cls = @GetEntityClass!
    ent = scripted_ents.Get(cls) if cls and cls ~= ""
    printName = ent and ent.PrintName or @PrintName
    printName = "MG Emplacement" if cls == "npc_manned_emplacement" -- REALLY cheap fix, I need to rewrite the emplacement entity in yue

    dist_sqr = @GetPos!\DistToSqr(lp\GetPos!)
    return unless dist_sqr < 128^2
    font = "Spleen_Label"
    desp = lp\GetDespair! * 0.01
    ct = CurTime!
    pos = @GetPos! + (@GetUp! * 6) - (@GetForward! * 18) + (@GetRight! * 13)
    ang = @GetAngles!
    with ang
      \RotateAroundAxis \Up!, 90
      \RotateAroundAxis \Forward!, 0
      \RotateAroundAxis \Right!, 0
    -- 3D2D start: name
    cam.Start3D2D pos, ang, 0.1
    -- draw a rectangle, on which to draw the text atop
    surface.SetMaterial noise
    surface.SetDrawColor Color(255,255,255,255)
    surface.DrawTexturedRect 0, 0, 265, 38
    -- render the name
    txt = "#{printName}"
    txt_obj = scribe.Parse "<stutter><rgb=1,1,30><wiggle=#{8 * desp},#{10 * desp}><f=#{font}><wave=#{6 * desp},#{0.38 * desp},2><ol=2>#{txt}"
    txt_obj\Draw 8, 6, 1, TEXT_ALIGN_LEFT
    -- 3D2D end
    cam.End3D2D!
    -- 3D2D start: precursors
    pos = @GetPos! + (@GetUp! * 6) - (@GetForward! * 7) + (@GetRight! * 11)
    
    for p in *@Precursors
      -- we check if the precursor is needed
      continue if p and p.name and getCostFromCls(cls, p.name) <= 0
      pos += (-@GetForward! * 3)
      cam.Start3D2D pos, ang, 0.1
      name = "#{p.name\sub(1, 1)\upper!}#{p.name\sub(2, -1)}"
      amt = @["GetPrecursor#{name}"](@)
      cost = getCostFromCls(cls, p.name)
      amt_str = "<c=200,0,0>#{amt}" if amt < cost
      amt_str or= "<c=0,200,0>#{amt}"
      txt = "#{p.name\sub(1, 1)\upper!}#{p.name\sub(2, -1)}: #{amt_str}/#{cost}"
      txt_obj = scribe.Parse "<stutter><rgb=1,1,30><wiggle=#{8 * desp},#{10 * desp}><f=#{font}><wave=#{6 * desp},#{0.38 * desp},2><ol=2>#{txt}"
      txt_obj\Draw 8, 6, 1, TEXT_ALIGN_LEFT
      cam.End3D2D!
    

  Sound: "Equip_Weapon"

  IsFinished: =>
    cls = @GetEntityClass!
    return false unless cls and cls ~= ""

    for p in *@Precursors
      cost = getCostFromCls(cls, p.name)
      if cost > 0
        name = "#{p.name\sub(1, 1)\upper!}#{p.name\sub(2, -1)}"
        amt = @["GetPrecursor#{name}"](@)
        if not amt or amt < cost
          return false
    return true

  Initialize: =>
    @SetModel @Model
    if SERVER
      @PhysicsInit SOLID_VPHYSICS
      @SetMoveType MOVETYPE_VPHYSICS
      @SetSolid SOLID_VPHYSICS
      @PhysWake!
    @SetStarted false

  OnTakeDamage: (dmg) => @TakePhysicsDamage dmg

  SetConstruct: (cls) =>
    @SetEntityClass cls
    for p in *@Precursors
      name = "#{p.name\sub(1, 1)\upper!}#{p.name\sub(2, -1)}"
      set = @["SetPrecursor#{name}"]
      set(@, 0) if set

  OnUseFinish: (ply) =>
    @index or= 1
    if not @GetStarted!
      if @index >= #entity_cost
        @index = 1
      else
        @index += 1
      @SetConstruct entity_cost[@index].cls
      return

    return unless @IsFinished!

    super ply

    if SERVER
      cls = @GetEntityClass!
      ent = ents.Create cls
      if IsValid ent
        with ent
          \SetPos @GetPos!
          \SetAngles @GetAngles!
          \Spawn!
          \CPPISetOwner ply -- used for prop protection, they can physgun or delete the trap now
          \Activate!
        @Remove!

if SERVER 
  block_types = {"Physgun1", "Spawning1", "Toolgun1"}
  FPP.AddDefaultBlocked(block_types, "evilrp/spawned/weapon")
  FPP.AddDefaultBlocked(block_types, "evilrp_weapon")