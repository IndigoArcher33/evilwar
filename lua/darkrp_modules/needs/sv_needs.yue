hook.Add "Initialize", "evilrp_setup_table_needs", ->
  unless sql.TableExists( "evilrp_needs" )
    sql.Query( "CREATE TABLE evilrp_needs( SteamID TEXT, Hunger FLOAT, Thirst FLOAT, Despair FLOAT )" )

hook.Add "PlayerInitialSpawn", "evilrp_setup_player_needs", (ply) ->
  ply.evilrp_needs_rtable = sql.Query( "SELECT SteamID, Hunger, Thirst, Despair FROM evilrp_needs WHERE SteamID = '" .. ply\SteamID64! .. "'" )
  unless ply.evilrp_needs_rtable
    sql.Query( "INSERT INTO evilrp_needs( SteamID, Hunger, Thirst, Despair ) VALUES( '" .. ply\SteamID64! .. "', 0, 0, 0 )" )
  ply.evilrp_needs = sql.Query( "SELECT SteamID, Hunger, Thirst, Despair FROM evilrp_needs WHERE SteamID = '" .. ply\SteamID64! .. "'" )[1]
  ply\SetNWFloat( "evilrp_needs_hunger", tonumber(0) )
  ply\SetNWFloat( "evilrp_needs_thirst", tonumber(0) )
  ply\SetNWFloat( "evilrp_needs_despair", tonumber(0) )
