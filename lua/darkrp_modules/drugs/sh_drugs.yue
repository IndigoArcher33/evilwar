class Submit_Drug extends SOUND
  sound: ["npc/barnacle/barnacle_pull#{i}.wav" for i=1,4]

class Drug extends ITEM
  SetupDataTables: =>
    super!

  PrintName: "Drug"
  Model: Model"models/props_junk/garbage_plasticbottle002a.mdl"
  Category: "EvilRP: Drugs"
  Spawnable: true
  Interesting: true

  Sound: Sound"ghostbong/ghostbong_hit.mp3"
  SubmitSound: "Submit_Drug"

  Hunger: 0 -- use negative numbers to satisfy a status
  Thirst: 0
  Despair: 0
  HealthAdd: 0 -- temp until we get a new health system
  CookTime: 0 -- time this item takes to be cooked
  DrugTime: 0 -- if 0, never ends

  Consume: (ply) =>
    return if CLIENT
    ply.Drugs or= {}
    drugName = @PrintName or tostring(@)
    onEnd = @End
    onThink = @ConsumeThink

    ply.Drugs[drugName] = {
      end: CurTime! + @DrugTime
      onEnd: onEnd
      onThink: onThink
    }

    local amt
    if @Hunger
      amt = @Hunger
      amt = amt! if isfunction(amt)
      ply\AddHunger amt
    if @Thirst
      amt = @Thirst
      amt = amt! if isfunction(amt)
      ply\AddThirst amt
    if @Despair
      amt = @Despair
      amt = amt! if isfunction(amt)
      ply\AddDespair amt
    if @HealthAdd
      amt = @HealthAdd
      amt = amt! if isfunction(amt)
      if amt > 0
        ply\SetHealth math.min( ply\Health! + amt, ply\GetMaxHealth! )
      elseif amt < 0
        ply\TakeDamage -amt
        -- if @GetRotten!
        --   ply\AddStatus STATUS_POISON, math.random(1,3)
    @Trash! if not @PersistAfterEat

  OnUseFinish: (ply) =>
    super ply
    @Consume ply

  ConsumeThink: (ply) =>
  End: (ply) => 


class Rotmelange extends Drug
  PrintName: "Rot Melange"
  Model: Model"models/props_c17/TrapPropeller_Lever.mdl"
  Hunger: 20
  Thirst: 10
  HealthAdd: 20
  Despair: -30
  RotTime: 240
  Description: "A cigar packed with a mysterious substance from the wasteland.\nIt will reveal your deepest worries, if you're strong enough."
  Sound: Sound"ghostbong/ghostbong_hit.mp3"
  DrugTime: 180

  UseText: {
    "takes a fat rip of melange."
    "smokes a mysterious cigar."
    "lights up a red cigar."
    "smokes enough melange to trigger a smoke alarm."
    "smokes it to the butt."
    "takes a strong hit of melange."
    "leaves a disgusting cloud of red smoke."
  }

  NotifyText: {
    "The future..."
    "The past..."
    "The present..."
    "Everything..."
    "Memories..."
    "A sweet lie..."
  }

  ConsumeThink: (ply, drug) =>
    drug.nextTime or= 0
    if CurTime! >= drug.nextTime
      drug.nextTime = CurTime! + 30 + math.random(1, 30)
      net.Start"evilrp_jumpscare"
      net.Send ply
      ply\AddStemCells(1)
      ply\Notify "<c=0,200,0> #{table.Random @NotifyText}"

  Consume: (ply) =>
    super ply
    return if CLIENT
    if (ply\Team! ~= TEAM_EMPEROR) and (ply\Team! ~= TEAM_STALKER)
      ply\Notify "<c=200,0,0> WHAT THE FUCK IS THIS? HOLY SHI~"
      ply\AddDespair 100
      net.Start"evilrp_jumpscare"
      net.Send ply
      return

    ply\AddStemCells(2)
    ply\Notify "<c=0,200,0> Embrace the prescient path."
  
  End: (ply) => 
    super ply
    return if CLIENT
    ply\Notify "<c=200,0,0> Your addiction to melange slowly fades."


drug_think = ->
  return if CLIENT
  for ply in *player.GetAll!
    if not ply\Alive!
      ply.Drugs = {}
      return
    continue unless ply.Drugs
    for key, drug in pairs ply.Drugs
      if CurTime! > drug.end
        drug.onEnd nil, ply
        ply.Drugs[key] = nil
      else
        drug.onThink nil, ply, drug

hook.Add "Think", "evilrp_drug_think", drug_think