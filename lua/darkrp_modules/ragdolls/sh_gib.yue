class Gib extends ENTITY
  Base: "base_anim"
  Type: "anim"
  Spawnable: true
  AdminSpawnable: true
  Pocketable: false
  Initialize: =>
    return if CLIENT
    @PhysicsInit SOLID_VPHYSICS
    @SetCollisionGroup COLLISION_GROUP_WEAPON
    @SetUseType SIMPLE_USE
    phys = @GetPhysicsObject!
    phys\Wake! if phys and IsValid(phys)
  PhysicsCollide: (data, physobj) =>
    if data.Speed >= 64
      ed = EffectData!
      with ed
        \SetStart @GetPos!
        \SetOrigin @GetPos!
        \SetScale 8
      util.Effect "BloodImpact", ed, true, true
      util.Decal "Blood",
        data.HitPos - data.HitNormal,
        data.HitPos + data.HitNormal
      if @GetModel! == "models/in/player/head.mdl" then
        @EmitSound "physics/flesh/flesh_squishy_impact_hard#{math.random 1,4}.wav",
          60,
          math.random(70, 110)
      else
        @EmitSound "physics/flesh/flesh_bloody_impact_hard1.wav",
          60,
          math.random(70, 110)
  OnTakeDamage: (dmg) =>
    @TakePhysicsDamage dmg
    dt = dmg\GetDamageType!
    if (@GetModel! ~= "models/in/player/head.mdl") and (dt == DMG_SLASH or dt == DMG_CLUB)
      ed = EffectData!
      with ed
        \SetStart @GetPos!
        \SetOrigin @GetPos!
        \SetScale 8
      util.Effect "BloodImpact", ed, true, true
      @Remove!
