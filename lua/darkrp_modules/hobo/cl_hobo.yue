tell_the_truth_hook = (ply, bind, pressed) ->
  wep = LocalPlayer!\GetActiveWeapon!
  if ply == LocalPlayer! and wep\IsValid! and string.find(string.lower(bind), "attack2") and wep\GetClass! == "weapon_bugbait"
    LocalPlayer!\ConCommand("tell_the_truth")

hook.Add "PlayerBindPress", "evilrp_tell_the_truth", tell_the_truth_hook
