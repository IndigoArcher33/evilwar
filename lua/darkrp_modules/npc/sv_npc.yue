global EVIL_NEXT_NPC = 0
EVIL_NPC_DELAY = 40
EVIL_NPC_MAX = 7
WASTELAND_SPAWNS = {
  ["rp_lymphoma"]: 
    * pos: 
        *Vector( 3851, -8322, -9 )
      cls: "evilrp_npc"
      max: 2
    * pos: 
        *Vector( 516, -5454, -72 )
        *Vector( -690, -5391, -133 )
        *Vector( -91, -6663, -202 )
        *Vector( 15, -5648, -61 )
      cls: "npc_antlion"
      max: 3
  
}

hook.Add "Think", "evilrp_npc_spawner", ->
  if CurTime! >= EVIL_NEXT_NPC
    EVIL_NEXT_NPC = CurTime! + EVIL_NPC_DELAY + math.random(EVIL_NPC_DELAY)
    map = game.GetMap!
    if WASTELAND_SPAWNS[map]
      for spawn in *WASTELAND_SPAWNS[map]
        amt = ents.FindByClass spawn.cls
        if #amt < spawn.max
          npc = ents.Create spawn.cls
          with npc
            \SetPos spawn.pos[math.random(#spawn.pos)]
            \Spawn!
            \Activate!
  return
