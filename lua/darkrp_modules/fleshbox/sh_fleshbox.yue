class BoxHurt extends SOUND
  sound: ["physics/flesh/flesh_squishy_impact_hard#{i}.wav" for i=1,4]
  pitch: {80, 115}

class BoxSpawn extends SOUND
  sound: "placenta/bonehead_aggrod3.wav"
  pitch: {80, 130}

class BoxDeath extends SOUND
  sound: "dysphoria/gore/skullcrush1.ogg"
  pitch: {80, 130}

damage_types = {
  DMG_SLASH
  DMG_CLUB
  DMG_BURN
  DMG_BULLET
  DMG_BLAST
}

class Fleshbox extends ENTITY
  Base: "base_anim"
  Type: "anim"
  Spawnable: true
  Interesting: true
  AdminSpawnable: true

  Pocketable: false
  PrintName: "Decaying Cache"
    
  LootTable:
    * "crate/fleshcrate"

  SetupDataTables: =>
    @NetworkVar "Int", "Integrity"
    @NetworkVar "Int", "DamageFilter"

  Initialize: =>
    return if CLIENT
    @SetModel"models/props/de_prodigy/ammo_can_01.mdl"
    @SetMaterial"models/gibs/humans/liver_gib"
    @PhysicsInit SOLID_VPHYSICS
    @SetIntegrity 300
    @PhysWake!
    @EmitSound"BoxSpawn"
    @SetDamageFilter damage_types[math.random(1, #damage_types)]

  HUDRender: =>
    ct = {}
    ct[] = @PrintName
    ct[] = {
      text: "An old military cache, you don't recognise the markings."
      font: "Spleen_Label_Small"
    }
    ct[] = {
      text: "It seems to have something inside. DMG: #{@GetDamageFilter}"
      font: "Spleen_Label_Small"
    }
    return ct


  OnTakeDamage: (dmg) =>
    dtype = dmg\GetDamageType!
    return unless ( dtype == @GetDamageFilter!)
    dmg_int = dmg\GetDamage!
    inflictor = dmg\GetInflictor!
    dmg_int *= inflictor.TreeBonus if inflictor.TreeBonus
    pos = dmg\GetDamagePosition!
    with edata := EffectData!
      \SetOrigin pos
      \SetScale 60
      util.Effect "BloodImpact", edata
        
    @SetIntegrity @GetIntegrity! - dmg_int
    @NextSound or= CurTime!
    if CurTime! >= @NextSound
      @NextSound = CurTime! + 0.1
      @EmitSound"TreeHurt"
    if (@GetIntegrity! <= 0) and not @Breaking
      @Breaking = true
      @EmitSound"BoxDeath"
      for i=1,math.random(1,3)
        cls = @LootTable[math.random 1, #@LootTable]
        loot = ents.Create cls
        with loot
          \Spawn!
          \Activate!
          \SetPos pos
      @Remove!

