EVIL_LOOT_REPLACEMENTS = {
  ["rp_liverfailure_kidneydagger"]:
    ["models/props_junk/trashdumpster01a.mdl"]: "lootable/dumpster"
}

create_loot = ->
  map = game.GetMap!
  for lootable in *ents.FindByClass"lootable/*"
    lootable\Remove! unless lootable.leave_alone
  if EVIL_LOOT_POSITIONS[map]
    for v in *EVIL_LOOT_POSITIONS[map]
      sp = ents.Create v.cls
      with sp
        \SetPos v.pos
        \SetAngles v.ang
        \Spawn!
        \Activate!
        \GetPhysicsObject!\EnableMotion false
  if EVIL_LOOT_REPLACEMENTS[map]
    for e in *ents.FindByClass"prop_dynamic"
      replacement = EVIL_LOOT_REPLACEMENTS[map][e\GetModel!]
      if replacement
        sp = ents.Create replacement
        with sp
          \SetPos e\GetPos!
          \SetAngles e\GetAngles!
          e\Remove!
          \Spawn!
          \Activate!
          \GetPhysicsObject!\EnableMotion false
          .leave_alone = true
  return
    
hook.Add "InitPostEntity", "evilrp_create_loot", create_loot
