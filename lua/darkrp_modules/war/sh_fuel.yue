class Fuel extends ITEM
  @__entity: "fuel"
  Spawnable: true

  Model: Model"models/props_junk/metalgascan.mdl"

  PrintName: "Biofuel"
  Description: "A big ol' jerrycan full of corpse oil-turned-generator juice."
  UseText: {
    "lifts a heavy jerrycan to his lips and chugs some strong-smelling, fuming oil."
    "unscrews a jerrycan, gets a good sniff of corpse oil fumes, bends backwards -- and FUCKING DRINKS IT."
  }

  FuelAdd: 15

  TrashClass: "trash/fuel"

  OnlyInventoryUse: false

  Sound: "DrinkFluid"

  OnUseFinish: (ply) =>
    super ply
    dmg = DamageInfo!
    with dmg
      \SetDamage 25
      \SetDamageType DMG_NERVEGAS
      \SetAttacker ply
      \SetInflictor @
      \SetDamagePosition ply\EyePos!
    ply\TakeDamageInfo dmg
    @Trash!

  Explode: =>
    return if @exploding
    @exploding = true
    util.ScreenShake @GetPos!, 25, 150, 1, 750
    explo = ents.Create"env_explosion"
    with explo
      \SetOwner @
      \SetPos(@GetPos!)
      \SetKeyValue("iMagnitude", @FuelAdd * 2.5)
      \SetKeyValue("iRadiusOverride", math.min( 400, @FuelAdd * 1.5) )
      \Spawn()
      \Activate()
      \Fire("Explode")
    fire_ent = ents.Create"env_fire"
    with fire_ent
      \SetPos(@GetPos!)
      \SetKeyValue("spawnflags", "1")
      \SetKeyValue("attack", tostring(math.random(10, 15)))
      \SetKeyValue("firesize", tostring(math.random(100, 150)))
      \Spawn!
      \Activate!
      \Fire("Enable", "", del)
      \Fire("StartFire", "", del)
      SafeRemoveEntityDelayed(fire_ent, math.random(60, 70))
    victims = ents.FindInSphere @GetPos!, @FuelAdd * 6
    for victim in *victims
      ignition = false
      ignition = true if victim\IsPlayer! and victim\Alive!
      ignition = true if victim\GetClass! == "prop_physics"
      victim\Ignite math.random(5,10) if ignition
    @Remove!
