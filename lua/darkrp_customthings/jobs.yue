TEAM_EMPEROR = DarkRP.createJob "Emperor",
  color: Color(150, 20, 20)
  model: "models/vel/evilwar/royalist.mdl"
  description: "Rule with an iron fist."
  command: "emperor"
  salary: 1
  weapons: {"evilrp_weapon/novoluger"}
  max: 1
  cost: 5
  weapons: {}
  hasLicense: true
  mayor: true
  use_machines: false
  category: "Royalists"
  speech_sounds: ["placenta/speech/chatter#{i}.ogg" for i=1,15]
  become_sounds: {"kidneydagger/broadcast1.wav"}
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "Listen carefully."
      when TEAM_STALKER
        text = "Oh, your majesty!"
      when TEAM_SANITAR
        text = "Hail, hail!"
      when TEAM_KORPSMAN
        text = "Is he feeling okay?"
      when TEAM_DEALER
        text = "Glorious leader.\nI'm nothing without him."
      when TEAM_EMPEROR
        text = "Our strength\nshall prevail."
      when TEAM_GHOST
        text = "So full of lies."
      when TEAM_BONEHEAD
        text = "THERE HE IS!!"
    return { :text, font: "Spleen_Label_Small" }, true
  
  first_names: {"Basileus", "Agrippa", "Gnaeus", "Gaius"}
  last_names: {"Imperator Lymphoma", "Kaiser Lymphoma", "Rex Lymphoma", "Lymphoma Magnus"}
  special_name: "Which Kaiser"
  special_name_chance: 1000
  ShowSpare1: open_player_menu
  ShowSpare2: open_action_menu
  bar_names:
    health: "PRIDE"
  PlayerLoadout: (ply) ->
    ply\ClearOddities!
    oddities = [v for k, v in pairs(ODDITY.list) when v ~= ODDITY_ILLITERACY]
    ply\AddOddity oddities[math.random(#oddities)]
    set_bodygroup(ply, slot, val) for slot, val in pairs {
      -- torse
      [0]: 1
      -- vest
      [1]: 2
      -- headwear
      [2]: 0
      -- face
      [3]: 1
      -- pants
      [4]: 2
      -- hands
      [5]: 0
    }
    ply\SetNWInt("evilrp_gasmask", 4)
    ply\Give"evilrp_weapon/novoluger"
    ply\SetArmor( 65 )
    return false

GAMEMODE.CivilProtection =
  [TEAM_PRIVATE]: true
  [TEAM_SANITAR]: true
  [TEAM_EMPEROR]: true

GAMEMODE.DefaultTeam = TEAM_GHOST
