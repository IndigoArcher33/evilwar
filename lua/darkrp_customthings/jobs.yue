  command: "medic"
  salary: 1
  max: 2
  cost: 2
  hasLicense: false
  medic: true
  use_machines: false
  category: "Royalists"
  speech_sounds: ["placenta/speech/korps#{i}.wav" for i=1,4]
  hurt_sounds: ["placenta/pain/sanitar#{i}.wav" for i=1,4]
  become_sounds: {"items/suitchargeok1.wav"}
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "I forgot what\nto call these guys."
      when TEAM_STALKER
        text = "A walking blood bag."
      when TEAM_SANITAR
        text = "Better remember\nwho lets them live."
      when TEAM_KORPSMAN
        text = "Something to\nbe happy about."
      when TEAM_DEALER
        text = "Keep them busy.\nWe need their blood and sweat."
      when TEAM_EMPEROR
        text = "What a strange,\nselfless thing."
      when TEAM_GHOST
        text = "A respectable mortal."
      when TEAM_BONEHEAD
        text = "CONFUSING."
    return { :text, font: "Spleen_Label_Small" }, true
  first_names: {"Dissector", "Retractor", "Suture", "Femur", "Cystic", "Rasp", "Ferrum", "Fascia", "Marrow", "Lienis", "Aorta", "Tunica", "Maxilla", "Sacrum", "Leach" }
