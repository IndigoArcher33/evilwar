-- For examples and explanation please visit this wiki page:
-- https://darkrp.miraheze.org/wiki/DarkRP:CustomJobFields

import Config from GAMEMODE

-- `global ^' makes all variable defs that begin with uppercase
-- characters globals by default.
global ^

set_bodygroup = (ply, slot, val) ->
  if type(val) == "table"
    -- it *should* be a sequential table
    val = val[math.random(1, #val)]
  ply\SetBodygroup slot, val

open_player_menu = (ply) ->
  return unless CLIENT
  if lp\Alive!
    GAMEMODE\CreatePlayerMenu!
  else
    GAMEMODE\Frighten!

open_action_menu = (ply) ->
  return unless CLIENT
  tr = GAMEMODE\GetHandTrace(ply, 80)
  GAMEMODE\OpenActionMenu(tr.HitPos, tr.Entity)

TEAM_GHOST = DarkRP.createJob "Ghost",
  color: Color(150, 150, 150)
  model: "models/player/skeleton.mdl"
  description: "A lost soul."
  instant_respawn: true
  weapons: {}
  command: "ghost"
  salary: 1
  max: 0
  cost: 0
  use_machines: false
  speech_sounds: {"ambient/voices/squeal1.wav"}
  crosstext: (ply) ->
    -- presumably, these only apply to cotards
    text = "OH SOTLA,\nTHE HORROR."
    switch lp\Team!
      when TEAM_KORPSMAN
        text = "Evil spirits wander!\n<wiggle>Not on my shift."
      when TEAM_GHOST
        text = "We're the same,\nyou and I."
    return { :text, font: "Spleen_Label_Small" }
  first_names: {"Suffering", "Fear", "Agony", "Malice", "Hatred", "Grief", "Pain", "Despair", "Rage" }
  -- special_name: "gost"
  -- special_name_chance: 10000
  ShowSpare1: (ply) ->
    if CLIENT
      GAMEMODE\Frighten!
  ShowSpare2: (ply) ->
    nearby = ents.FindInSphere(ply\GetPos!, 16)
    local found
    for ent in *nearby
      if ent\GetClass!\find"portal/spawn"
        found = ent
        break
    unless found and IsValid(found)
      if CLIENT
        GAMEMODE\Frighten!
      else
        ply\Notify"<c=200,0,0>There is no purpose in life near me."
    elseif SERVER
      found\Use(ply)
  PlayerLoadout: (ply) ->
    -- We don't want ghosts to get default weapons.
    ply\ClearOddities!
    ply\SetNWInt "evilrp_gasmask", 0
    return true
  ColorMod: (ply) ->
    import abs, cos, sin from math
    ct = CurTime!
    tab =
        ["$pp_colour_addr"]: 0
        ["$pp_colour_addg"]: 0
        ["$pp_colour_addb"]: 0
        ["$pp_colour_brightness"]: 0 + (-0.01 * cos(ct))
        ["$pp_colour_contrast"]: 0.6 + (abs(sin(ct * 0.166)) * 0.5)
        ["$pp_colour_colour"]: 0
        ["$pp_colour_mulr"]: 0 + abs(sin(ct * 0.789))
        ["$pp_colour_mulg"]: 0
        ["$pp_colour_mulb"]: 0
    return tab

TEAM_STALKER = DarkRP.createJob "Stalker",
  color: Color(20, 150, 20)
  model: "models/liver_failure/wastelander/wastelander.mdl"
  description: "A soul with no allegiance, destined to plunder the wasteland."
  weapons: {"evilrp_weapon/whisper", "evilrp_melee/axe"}
  category: "Wasteland"
  command: "stalker"
  salary: 1
  max: 3
  cost: 4
  hasLicense: false
  candemote: false
  use_machines: false
  speech_sounds: ["placenta/cultspawn#{i}.wav" for i=1,9]
  hurt_sounds: ["placenta/pain/cult#{i}.wav" for i=1,6]
  become_sounds: ["npc/zombie/zombie_alert#{i}.wav" for i=1,3]
  death_sounds: ["placenta/death/cult#{i}.wav" for i=1,4]
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "He doesn't look like me."
      when TEAM_STALKER
        text = "A fellow plunderer."
      when TEAM_SANITAR
        text = "Despicable."
      when TEAM_KORPSMAN
        text = "Why is he here?"
      when TEAM_DEALER
        text = "Keep the armaments locked up."
      when TEAM_EMPEROR
        text = "He might be of use to me."
      when TEAM_GHOST
        text = "He has a noble pursuit."
      when TEAM_BONEHEAD
        text = "SEEN HIM BEFORE!!"
    return { :text, font: "Spleen_Label_Small" }, false
  first_names: { "Wasted", "Decrepit", "Rotten", }
  last_names: { "Soul", "Plunderer", "Traitor", "Wanderer", }
  bar_names:
    health: "regret"
  special_name: "Waste"
  special_name_chance: 1000
  ShowSpare1: open_player_menu
  ShowSpare2: open_action_menu
  PlayerLoadout: (ply) ->
    ply\ClearOddities!
    ply\AddOddity ODDITY.list[math.random(#ODDITY.list)]
    set_bodygroup(ply, slot, val) for slot, val in pairs {
      -- head
      [0]: 0
      -- legs
      [1]: 2
      -- torso
      [2]: {2, 3, 8, 6}
      -- headgear
      [3]: {19, 20}
      -- bandana
      [4]: 0
      -- mask
      [5]: 0
      -- hat mask
      [6]: {0,1,2,3}
      -- fullmask
      [7]: 0
      -- glasses
      [8]: 0
      -- hands
      [9]: {0,1}
    }
    skins = {4,6,7}
    ply\SetSkin skins[math.random(1, #skins)]
    return false

class SpeechBonehead extends SOUND
  sound: "placenta/bonehead_aggrod4.wav"
  pitch: {200, 250}

TEAM_BONEHEAD = DarkRP.createJob "Bonehead",
  color: Color(150, 150, 150)
  model: "models/player/zombie_fast.mdl"
  description: "evil fucker."
  instant_respawn: true
  command: "bonehead"
  salary: 1
  max: 0
  cost: 1
  use_machines: false
  speech_sounds: "SpeechBonehead"
  hurt_sounds: ["placenta/bonehead_slice#{i}.wav" for i=1,2]
  become_sounds: ["placenta/bonehead_aggrod#{i}.wav" for i=1,4]
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "Oh no! He's real!"
      when TEAM_SANITAR
        text = "Oh boy."
      when TEAM_KORPSMAN
        text = "Oh no! It happened again!"
      when TEAM_DEALER
        text = "Free ribs to feed the troops."
      when TEAM_EMPEROR
        text = "Ha. It happened again."
      when TEAM_GHOST
        text = "Lookin' good."
      when TEAM_BONEHEAD
        text = "THERE'S ANOTHER ONE."
    return { :text, font: "Spleen_Label_Small" }, false
  first_names: { "Evil" }
  last_names: { "Fucker"}
  no_needs: true
  hint: "You are a truly pissed off skeleton. Go get 'em!"
  bar_names:
    health: "EVIL FUCKER POWER"
  bar_colors:
    health: Color(200,0,0)
  RenderScreenspaceEffects: (ply) ->
    ct = CurTime!
    DrawMotionBlur 0.25, 0.2, 0.3
    DrawSharpen 1 * math.sin(ct), 2 * math.random(0.8, 1.2)
  ColorMod: (ply) ->
    import abs, cos, sin from math
    ct = CurTime!
    tab =
      ["$pp_colour_addr"]: 0.1
      ["$pp_colour_addg"]: 0
      ["$pp_colour_addb"]: 0
      ["$pp_colour_brightness"]: 0 + (-0.01 * cos(ct))
      ["$pp_colour_contrast"]: 1.6 + (abs(sin(ct * 0.166)) * 0.5)
      ["$pp_colour_colour"]: 0
      ["$pp_colour_mulr"]: 0 + abs(sin(ct * 0.789))
      ["$pp_colour_mulg"]: 0
      ["$pp_colour_mulb"]: 0
    return tab
  ShowSpare1: ->
    if CLIENT
      GAMEMODE\Frighten!
  ShowSpare2: ->
    if CLIENT
      GAMEMODE\Frighten!
  PlayerLoadout: (ply) ->
    ply\SetNWInt "evilrp_gasmask", 0
    ply\Give("evilrp_melee/hands/boneclaws")
    return true
  HandleRagdoll: (rag, ply) ->
    rag\SetNWInt("decomp_stage", DSTAGE_BONES)
    
TEAM_PRIVATE = DarkRP.createJob "Private",
  color: Color(20, 150, 20)
  model: "models/vel/evilwar/royalist.mdl"
  description: "A new recruit that hasn't gone through training yet."
  command: "proletariat"
  salary: 1
  max: 0
  cost: 0
  hasLicense: true
  candemote: false
  use_machines: true
  category: "Royalists"
  speech_sounds: ["placenta/speech/prole#{i}.wav" for i=1,3]
  hurt_sounds: ["placenta/pain/prole#{i}.wav" for i=1,5]
  become_sounds: ["npc/zombie/zombie_alert#{i}.wav" for i=1,3]
  death_sounds: ["placenta/death/prole#{i}.wav" for i=1,3]
  crosstext: (ply) ->
    text = "Don't panic."
    switch lp\Team!
      when TEAM_PRIVATE
        text = "United in rank?"
      when TEAM_STALKER
        text = "A soldier from Lymphoma."
      when TEAM_SANITAR
        text = "These soldiers need guidance.\nPut the fear in their hearts."
      when TEAM_KORPSMAN
        text = "Smelly and stupid."
      when TEAM_DEALER
        text = "Prove your place, worm.\nOnly then will you be decorated."
      when TEAM_EMPEROR
        text = "Is he working hard enough?"
      when TEAM_GHOST
        text = "Sad, but funny."
      when TEAM_BONEHEAD
        text = "SKIN...!"
    return { :text, font: "Spleen_Label_Small" }, false
  first_names: { "Private", "PVT.", "Recruit", "Enlistee", "Grunt", "Fodder", "Cadet", "CDT.", "Rookie"}
  GenerateName: (ply) =>
    unit_id = math.random 1, 99
    if unit_id < 10
      unit_id = "0#{unit_id}"
    else
      unit_id = tostring unit_id
    return @first_names[math.random(1,#@first_names)] .. " #" .. unit_id
  special_name: "private parts"
  special_name_chance: 1000
  ShowSpare1: open_player_menu
  ShowSpare2: open_action_menu
  PlayerLoadout: (ply) ->
    ply\ClearOddities!
    ply\AddOddity ODDITY.list[math.random(#ODDITY.list)]
    set_bodygroup(ply, slot, val) for slot, val in pairs {
      -- torse
      [0]: 0
      -- vest
      [1]: 0
      -- headwear
      [3]: {0, 6, 7, 8}
      -- face
      [4]: {0, 4}
      -- pants
      [5]: 0
      -- hands
      [6]: 0
    }
    return false

